import { useLocation, useNavigate } from "react-router-dom";
import { useState } from "react";

function Payment() {
  const location = useLocation();
  const navigate = useNavigate();

  const {
    flight,
    from,
    to,
    travelDate,
    passengers,
    passengerName,
    email,
    phone,
    selectedSeats,
  } = location.state || {};

  const [cardName, setCardName] = useState("");
  const [cardNumber, setCardNumber] = useState("");
  const [expiry, setExpiry] = useState("");
  const [cvv, setCvv] = useState("");

  if (!flight) {
    return (
      <div
        style={{
          padding: "50px",
          textAlign: "center",
          fontFamily: "Arial, sans-serif",
        }}
      >
        <h1>No Booking Found</h1>

        <p>Please start your booking again.</p>

        <button
          onClick={() => navigate("/")}
          style={{
            padding: "12px 25px",
            cursor: "pointer",
          }}
        >
          Back to Home
        </button>
      </div>
    );
  }

  const totalPrice = flight.price * passengers;

  const handlePayment = () => {
    if (!cardName || !cardNumber || !expiry || !cvv) {
      alert("Please fill all payment details");
      return;
    }

    const booking = {
      id: Date.now(),
      passengerName,
      email,
      phone,
      cardName,
      airline: flight.airline,
      flightNumber: flight.flightNumber,
      from,
      to,
      travelDate,
      passengers,
      selectedSeats,
      totalPrice,
      paymentStatus: "Paid",
    };

    const oldBookings =
      JSON.parse(localStorage.getItem("bookings")) || [];

    localStorage.setItem(
      "bookings",
      JSON.stringify([...oldBookings, booking])
    );

    alert("Payment successful! Booking confirmed.");

    navigate("/confirmation", {
      state: {
        booking: booking,
      },
    });
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f5f7fa",
        padding: "40px",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <div
        style={{
          maxWidth: "1000px",
          margin: "auto",
        }}
      >
        <h1>Payment</h1>

        <p>
          Complete your payment to confirm your booking.
        </p>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "1fr 1fr",
            gap: "25px",
            marginTop: "30px",
          }}
        >
          {/* Booking Summary */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              boxShadow: "0 3px 12px rgba(0,0,0,0.08)",
            }}
          >
            <h2>Booking Summary</h2>

            <hr />

            <p>
              <strong>Passenger:</strong>{" "}
              {passengerName}
            </p>

            <p>
              <strong>Airline:</strong>{" "}
              {flight.airline}
            </p>

            <p>
              <strong>Flight:</strong>{" "}
              {flight.flightNumber}
            </p>

            <p>
              <strong>Route:</strong>{" "}
              {from} → {to}
            </p>

            <p>
              <strong>Date:</strong>{" "}
              {travelDate}
            </p>

            <p>
              <strong>Passengers:</strong>{" "}
              {passengers}
            </p>

            <p>
              <strong>Seats:</strong>{" "}
              {selectedSeats?.join(", ")}
            </p>

            <hr />

            <h2>₹{totalPrice}</h2>

            <p>Total Amount</p>
          </div>

          {/* Payment Details */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              boxShadow: "0 3px 12px rgba(0,0,0,0.08)",
            }}
          >
            <h2>Payment Details</h2>

            <hr />

            {/* Card Holder Name */}

            <label>Card Holder Name</label>

            <input
              type="text"
              placeholder="Enter card holder name"
              value={cardName}
              onChange={(e) =>
                setCardName(e.target.value)
              }
              style={{
                width: "100%",
                padding: "12px",
                margin: "8px 0 20px",
                boxSizing: "border-box",
                border: "1px solid #ccc",
                borderRadius: "6px",
              }}
            />

            {/* Card Number */}

            <label>Card Number</label>

            <input
              type="text"
              placeholder="1234 5678 9012 3456"
              value={cardNumber}
              onChange={(e) =>
                setCardNumber(e.target.value)
              }
              style={{
                width: "100%",
                padding: "12px",
                margin: "8px 0 20px",
                boxSizing: "border-box",
                border: "1px solid #ccc",
                borderRadius: "6px",
              }}
            />

            {/* Expiry */}

            <label>Expiry Date</label>

            <input
              type="text"
              placeholder="MM/YY"
              value={expiry}
              onChange={(e) =>
                setExpiry(e.target.value)
              }
              style={{
                width: "100%",
                padding: "12px",
                margin: "8px 0 20px",
                boxSizing: "border-box",
                border: "1px solid #ccc",
                borderRadius: "6px",
              }}
            />

            {/* CVV */}

            <label>CVV</label>

            <input
              type="password"
              placeholder="123"
              value={cvv}
              onChange={(e) =>
                setCvv(e.target.value)
              }
              style={{
                width: "100%",
                padding: "12px",
                margin: "8px 0 25px",
                boxSizing: "border-box",
                border: "1px solid #ccc",
                borderRadius: "6px",
              }}
            />

            {/* Pay Button */}

            <button
              onClick={handlePayment}
              style={{
                width: "100%",
                padding: "14px",
                background: "#0066ff",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold",
                fontSize: "16px",
              }}
            >
              Pay ₹{totalPrice}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export default Payment;