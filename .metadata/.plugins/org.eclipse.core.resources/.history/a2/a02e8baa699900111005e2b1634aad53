import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

const API_URL = "http://localhost:8080";

function AdminFlights() {
  const navigate = useNavigate();

  const [flights, setFlights] = useState([]);
  const [airports, setAirports] = useState([]);

  const [loading, setLoading] = useState(true);
  const [adding, setAdding] = useState(false);
  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState(null);

  const [formData, setFormData] = useState({
    flightNumber: "",
    airlineName: "",
    economyPrice: "",
    premiumEconomyPrice: "",
    businessPrice: "",
    firstClassPrice: "",
    availableSeats: "52",
    totalSeats: "52",
    status: "ACTIVE",
    sourceAirportId: "",
    destinationAirportId: "",
  });

  // =====================================================
  // FETCH FLIGHTS
  // =====================================================

  const fetchFlights = async () => {
    try {
      const response = await fetch(
        `${API_URL}/api/flights`
      );

      if (!response.ok) {
        throw new Error("Unable to fetch flights");
      }

      const data = await response.json();

      console.log("FLIGHTS:", data);

      setFlights(
        Array.isArray(data) ? data : []
      );
    } catch (error) {
      console.error(
        "Flight fetch error:",
        error
      );

      alert(error.message);
    }
  };

  // =====================================================
  // FETCH ALL AIRPORTS
  // =====================================================

  const fetchAirports = async () => {
    try {
      const response = await fetch(
        `${API_URL}/api/airports`
      );

      if (!response.ok) {
        throw new Error("Unable to fetch airports");
      }

      const data = await response.json();

      console.log("ALL AIRPORTS:", data);

      if (Array.isArray(data)) {
        setAirports(data);
      } else {
        setAirports([]);
      }
    } catch (error) {
      console.error(
        "Airport fetch error:",
        error
      );

      setAirports([]);

      alert(
        "Unable to load airports. Please check /api/airports"
      );
    }
  };

  // =====================================================
  // INITIAL LOAD
  // =====================================================

  useEffect(() => {
    const loadData = async () => {
      setLoading(true);

      await Promise.all([
        fetchFlights(),
        fetchAirports(),
      ]);

      setLoading(false);
    };

    loadData();
  }, []);

  // =====================================================
  // HANDLE CHANGE
  // =====================================================

  const handleChange = (e) => {
    const { name, value } = e.target;

    setFormData((prev) => ({
      ...prev,
      [name]: value,
    }));
  };

  // =====================================================
  // RESET FORM
  // =====================================================

  const resetForm = () => {
    setFormData({
      flightNumber: "",
      airlineName: "",
      economyPrice: "",
      premiumEconomyPrice: "",
      businessPrice: "",
      firstClassPrice: "",
      availableSeats: "52",
      totalSeats: "52",
      status: "ACTIVE",
      sourceAirportId: "",
      destinationAirportId: "",
    });

    setEditingId(null);
    setShowForm(false);
  };

  // =====================================================
  // EDIT FLIGHT
  // =====================================================

  const handleEditFlight = (flight) => {
    console.log(
      "Editing Flight:",
      flight
    );

    setEditingId(flight.id);

    setFormData({
      flightNumber:
        flight.flightNumber || "",

      airlineName:
        flight.airlineName || "",

      economyPrice:
        flight.economyPrice ?? "",

      premiumEconomyPrice:
        flight.premiumEconomyPrice ?? "",

      businessPrice:
        flight.businessPrice ?? "",

      firstClassPrice:
        flight.firstClassPrice ?? "",

      availableSeats:
        flight.availableSeats ?? "52",

      totalSeats:
        flight.totalSeats ?? "52",

      status:
        flight.status || "ACTIVE",

      sourceAirportId:
        flight.sourceAirport?.id
          ? String(
              flight.sourceAirport.id
            )
          : "",

      destinationAirportId:
        flight.destinationAirport?.id
          ? String(
              flight.destinationAirport.id
            )
          : "",
    });

    setShowForm(true);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  // =====================================================
  // SAVE / UPDATE FLIGHT
  // =====================================================

  const handleSubmitFlight = async (e) => {
    e.preventDefault();

    // =================================================
    // VALIDATION
    // =================================================

    if (!formData.flightNumber.trim()) {
      alert("Please enter flight number");
      return;
    }

    if (!formData.airlineName.trim()) {
      alert("Please enter airline name");
      return;
    }

    if (!formData.economyPrice) {
      alert("Please enter Economy price");
      return;
    }

    if (!formData.premiumEconomyPrice) {
      alert(
        "Please enter Premium Economy price"
      );
      return;
    }

    if (!formData.businessPrice) {
      alert("Please enter Business price");
      return;
    }

    if (!formData.firstClassPrice) {
      alert("Please enter First Class price");
      return;
    }

    if (!formData.availableSeats) {
      alert("Please enter available seats");
      return;
    }

    if (!formData.totalSeats) {
      alert("Please enter total seats");
      return;
    }

    if (!formData.sourceAirportId) {
      alert("Please select source airport");
      return;
    }

    if (!formData.destinationAirportId) {
      alert(
        "Please select destination airport"
      );
      return;
    }

    if (
      formData.sourceAirportId ===
      formData.destinationAirportId
    ) {
      alert(
        "Source and destination cannot be same"
      );
      return;
    }

    if (
      Number(formData.availableSeats) >
      Number(formData.totalSeats)
    ) {
      alert(
        "Available seats cannot be greater than total seats"
      );
      return;
    }

    // =================================================
    // REQUEST BODY
    // =================================================

    const flight = {
      flightNumber:
        formData.flightNumber.trim(),

      airlineName:
        formData.airlineName.trim(),

      economyPrice:
        Number(formData.economyPrice),

      premiumEconomyPrice:
        Number(
          formData.premiumEconomyPrice
        ),

      businessPrice:
        Number(formData.businessPrice),

      firstClassPrice:
        Number(formData.firstClassPrice),

      availableSeats:
        Number(formData.availableSeats),

      totalSeats:
        Number(formData.totalSeats),

      status:
        formData.status || "ACTIVE",

      sourceAirport: {
        id: Number(
          formData.sourceAirportId
        ),
      },

      destinationAirport: {
        id: Number(
          formData.destinationAirportId
        ),
      },
    };

    console.log(
      editingId
        ? "UPDATING FLIGHT:"
        : "ADDING FLIGHT:",
      flight
    );

    // =================================================
    // TOKEN
    // =================================================

    const token =
      localStorage.getItem("token");

    const headers = {
      "Content-Type":
        "application/json",
    };

    if (token) {
      headers.Authorization =
        `Bearer ${token}`;
    }

    try {
      setAdding(true);

      // =================================================
      // UPDATE
      // =================================================

      if (editingId !== null) {
        const response =
          await fetch(
            `${API_URL}/api/flights/${editingId}`,
            {
              method: "PUT",
              headers,
              body: JSON.stringify(flight),
            }
          );

        const responseText =
          await response.text();

        console.log(
          "Update Status:",
          response.status
        );

        console.log(
          "Update Response:",
          responseText
        );

        if (!response.ok) {
          throw new Error(
            responseText ||
              "Unable to update flight"
          );
        }

        alert(
          "Flight updated successfully!"
        );

        resetForm();

        await fetchFlights();

        return;
      }

      // =================================================
      // ADD
      // =================================================

      const response =
        await fetch(
          `${API_URL}/api/flights`,
          {
            method: "POST",
            headers,
            body: JSON.stringify(flight),
          }
        );

      const responseText =
        await response.text();

      console.log(
        "Add Flight Status:",
        response.status
      );

      console.log(
        "Add Flight Response:",
        responseText
      );

      if (!response.ok) {
        throw new Error(
          responseText ||
            "Unable to add flight"
        );
      }

      alert(
        "Flight added successfully!"
      );

      resetForm();

      await fetchFlights();
    } catch (error) {
      console.error(
        "Flight Save Error:",
        error
      );

      alert(
        error.message ||
          "Unable to save flight"
      );
    } finally {
      setAdding(false);
    }
  };

  // =====================================================
  // DELETE FLIGHT
  // =====================================================

  const handleDeleteFlight = async (id) => {
    const confirmDelete =
      window.confirm(
        "Are you sure you want to delete this flight?"
      );

    if (!confirmDelete) {
      return;
    }

    try {
      const token =
        localStorage.getItem("token");

      const headers = {};

      if (token) {
        headers.Authorization =
          `Bearer ${token}`;
      }

      const response =
        await fetch(
          `${API_URL}/api/flights/${id}`,
          {
            method: "DELETE",
            headers,
          }
        );

      const responseText =
        await response.text();

      if (!response.ok) {
        throw new Error(
          responseText ||
            "Unable to delete flight"
        );
      }

      alert(
        "Flight deleted successfully!"
      );

      if (editingId === id) {
        resetForm();
      }

      await fetchFlights();
    } catch (error) {
      console.error(
        "Delete Flight Error:",
        error
      );

      alert(
        error.message ||
          "Unable to delete flight"
      );
    }
  };

  // =====================================================
  // CANCEL EDIT
  // =====================================================

  const handleCancelEdit = () => {
    resetForm();
  };

  // =====================================================
  // AIRPORT DISPLAY
  // =====================================================

  const getAirportDisplay = (airport) => {
    if (!airport) {
      return "Unknown Airport";
    }

    const city =
      airport.city || "";

    const code =
      airport.airportCode || "";

    const name =
      airport.airportName || "";

    if (city && code && name) {
      return `${city} - ${code} (${name})`;
    }

    if (city && code) {
      return `${city} - ${code}`;
    }

    if (city && name) {
      return `${city} - ${name}`;
    }

    if (name && code) {
      return `${name} - ${code}`;
    }

    return (
      city ||
      name ||
      code ||
      `Airport ${airport.id}`
    );
  };

  // =====================================================
  // LOADING
  // =====================================================

  if (loading) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          fontFamily:
            "Arial, sans-serif",
        }}
      >
        <h2>Loading...</h2>
      </div>
    );
  }

  // =====================================================
  // UI
  // =====================================================

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f5f7fa",
        padding: "40px",
        fontFamily:
          "Arial, sans-serif",
      }}
    >
      <div
        style={{
          maxWidth: "1500px",
          margin: "0 auto",
        }}
      >

        {/* =================================================
            HEADER
        ================================================= */}

        <div
          style={{
            display: "flex",
            justifyContent:
              "space-between",
            alignItems: "center",
            gap: "20px",
            flexWrap: "wrap",
          }}
        >
          <div>
            <h1>
              ✈ Manage Flights
            </h1>

            <p
              style={{
                color: "#666",
              }}
            >
              View and manage all flights.
            </p>
          </div>

          <div
            style={{
              display: "flex",
              gap: "10px",
            }}
          >

            <button
              type="button"
              onClick={() =>
                navigate(-1)
              }
              style={{
                padding:
                  "12px 22px",
                background:
                  "#dc2626",
                color: "white",
                border: "none",
                borderRadius:
                  "6px",
                cursor:
                  "pointer",
                fontWeight:
                  "bold",
              }}
            >
              ← Back
            </button>

            <button
              type="button"
              onClick={() => {
                if (
                  editingId !== null
                ) {
                  resetForm();
                } else {
                  setShowForm(
                    !showForm
                  );
                }
              }}
              style={{
                padding:
                  "12px 22px",
                background:
                  "#16a34a",
                color: "white",
                border: "none",
                borderRadius:
                  "6px",
                cursor:
                  "pointer",
                fontWeight:
                  "bold",
              }}
            >
              {editingId !== null
                ? "Cancel Edit"
                : showForm
                ? "Close Form"
                : "+ Add Flight"}
            </button>

          </div>
        </div>

        {/* =================================================
            ADD / EDIT FORM
        ================================================= */}

        {showForm && (
          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              boxShadow:
                "0 3px 12px rgba(0,0,0,0.08)",
              marginTop: "25px",
            }}
          >
            <h2>
              {editingId !== null
                ? `✏ Edit Flight #${editingId}`
                : "➕ Add New Flight"}
            </h2>

            {/* AIRPORT COUNT */}

            <div
              style={{
                background:
                  airports.length > 0
                    ? "#ecfdf5"
                    : "#fff7ed",
                color:
                  airports.length > 0
                    ? "#166534"
                    : "#c2410c",
                padding: "12px",
                borderRadius: "8px",
                marginBottom: "20px",
              }}
            >
              {airports.length > 0
                ? `${airports.length} airports available for selection`
                : "No airports found. Please add airports first."}
            </div>

            <form
              onSubmit={
                handleSubmitFlight
              }
            >
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "1fr 1fr",
                  gap: "20px",
                }}
              >

                {/* FLIGHT NUMBER */}

                <div>
                  <label>
                    <strong>
                      Flight Number
                    </strong>
                  </label>

                  <input
                    type="text"
                    name="flightNumber"
                    value={
                      formData.flightNumber
                    }
                    onChange={
                      handleChange
                    }
                    placeholder="Example: AI202"
                    style={inputStyle}
                  />
                </div>

                {/* AIRLINE */}

                <div>
                  <label>
                    <strong>
                      Airline Name
                    </strong>
                  </label>

                  <input
                    type="text"
                    name="airlineName"
                    value={
                      formData.airlineName
                    }
                    onChange={
                      handleChange
                    }
                    placeholder="Example: Air India"
                    style={inputStyle}
                  />
                </div>

                {/* =================================================
                    SOURCE AIRPORT DROPDOWN
                ================================================= */}

                <div>
                  <label>
                    <strong>
                      Source Airport
                    </strong>
                  </label>

                  <select
                    name="sourceAirportId"
                    value={
                      formData.sourceAirportId
                    }
                    onChange={
                      handleChange
                    }
                    style={inputStyle}
                    disabled={
                      airports.length === 0
                    }
                  >
                    <option value="">
                      -- Select Source Airport --
                    </option>

                    {airports.map(
                      (airport) => (
                        <option
                          key={
                            airport.id
                          }
                          value={
                            airport.id
                          }
                        >
                          {getAirportDisplay(
                            airport
                          )}
                        </option>
                      )
                    )}
                  </select>
                </div>

                {/* =================================================
                    DESTINATION AIRPORT DROPDOWN
                ================================================= */}

                <div>
                  <label>
                    <strong>
                      Destination Airport
                    </strong>
                  </label>

                  <select
                    name="destinationAirportId"
                    value={
                      formData.destinationAirportId
                    }
                    onChange={
                      handleChange
                    }
                    style={inputStyle}
                    disabled={
                      airports.length === 0
                    }
                  >
                    <option value="">
                      -- Select Destination Airport --
                    </option>

                    {airports.map(
                      (airport) => (
                        <option
                          key={
                            airport.id
                          }
                          value={
                            airport.id
                          }
                        >
                          {getAirportDisplay(
                            airport
                          )}
                        </option>
                      )
                    )}
                  </select>
                </div>

                {/* ECONOMY */}

                <div>
                  <label>
                    <strong>
                      Economy Price
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="economyPrice"
                    value={
                      formData.economyPrice
                    }
                    onChange={
                      handleChange
                    }
                    min="0"
                    style={inputStyle}
                  />
                </div>

                {/* PREMIUM ECONOMY */}

                <div>
                  <label>
                    <strong>
                      Premium Economy Price
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="premiumEconomyPrice"
                    value={
                      formData.premiumEconomyPrice
                    }
                    onChange={
                      handleChange
                    }
                    min="0"
                    style={inputStyle}
                  />
                </div>

                {/* BUSINESS */}

                <div>
                  <label>
                    <strong>
                      Business Price
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="businessPrice"
                    value={
                      formData.businessPrice
                    }
                    onChange={
                      handleChange
                    }
                    min="0"
                    style={inputStyle}
                  />
                </div>

                {/* FIRST CLASS */}

                <div>
                  <label>
                    <strong>
                      First Class Price
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="firstClassPrice"
                    value={
                      formData.firstClassPrice
                    }
                    onChange={
                      handleChange
                    }
                    min="0"
                    style={inputStyle}
                  />
                </div>

                {/* AVAILABLE SEATS */}

                <div>
                  <label>
                    <strong>
                      Available Seats
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="availableSeats"
                    value={
                      formData.availableSeats
                    }
                    onChange={
                      handleChange
                    }
                    min="0"
                    style={inputStyle}
                  />
                </div>

                {/* TOTAL SEATS */}

                <div>
                  <label>
                    <strong>
                      Total Seats
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="totalSeats"
                    value={
                      formData.totalSeats
                    }
                    onChange={
                      handleChange
                    }
                    min="1"
                    style={inputStyle}
                  />
                </div>

                {/* STATUS */}

                <div>
                  <label>
                    <strong>
                      Status
                    </strong>
                  </label>

                  <select
                    name="status"
                    value={
                      formData.status
                    }
                    onChange={
                      handleChange
                    }
                    style={inputStyle}
                  >
                    <option value="ACTIVE">
                      ACTIVE
                    </option>

                    <option value="CANCELLED">
                      CANCELLED
                    </option>

                    <option value="INACTIVE">
                      INACTIVE
                    </option>
                  </select>
                </div>

              </div>

              {/* =================================================
                  BUTTONS
              ================================================= */}

              <div
                style={{
                  display: "flex",
                  gap: "12px",
                  marginTop: "25px",
                }}
              >
                <button
                  type="submit"
                  disabled={
                    adding ||
                    airports.length === 0
                  }
                  style={{
                    padding:
                      "12px 25px",
                    background:
                      adding ||
                      airports.length === 0
                        ? "#9ca3af"
                        : "#0066ff",
                    color: "white",
                    border: "none",
                    borderRadius:
                      "6px",
                    cursor:
                      adding ||
                      airports.length === 0
                        ? "not-allowed"
                        : "pointer",
                    fontWeight:
                      "bold",
                  }}
                >
                  {adding
                    ? editingId !== null
                      ? "Updating Flight..."
                      : "Adding Flight..."
                    : editingId !== null
                    ? "Update Flight"
                    : "Add Flight"}
                </button>

                {editingId !== null && (
                  <button
                    type="button"
                    onClick={
                      handleCancelEdit
                    }
                    style={{
                      padding:
                        "12px 25px",
                      background:
                        "#6b7280",
                      color: "white",
                      border: "none",
                      borderRadius:
                        "6px",
                      cursor:
                        "pointer",
                      fontWeight:
                        "bold",
                    }}
                  >
                    Cancel
                  </button>
                )}
              </div>
            </form>
          </div>
        )}

        {/* =================================================
            FLIGHT TABLE
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "25px",
            borderRadius: "12px",
            boxShadow:
              "0 3px 12px rgba(0,0,0,0.08)",
            marginTop: "25px",
            overflowX: "auto",
          }}
        >
          <h2>All Flights</h2>

          {flights.length === 0 ? (
            <h3>
              No flights found.
            </h3>
          ) : (
            <table
              style={{
                width: "100%",
                borderCollapse:
                  "collapse",
                marginTop: "20px",
              }}
            >
              <thead>
                <tr>
                  <th style={thStyle}>
                    ID
                  </th>

                  <th style={thStyle}>
                    Flight Number
                  </th>

                  <th style={thStyle}>
                    Airline
                  </th>

                  <th style={thStyle}>
                    Source
                  </th>

                  <th style={thStyle}>
                    Destination
                  </th>

                  <th style={thStyle}>
                    Economy
                  </th>

                  <th style={thStyle}>
                    Premium Economy
                  </th>

                  <th style={thStyle}>
                    Business
                  </th>

                  <th style={thStyle}>
                    First Class
                  </th>

                  <th style={thStyle}>
                    Available
                  </th>

                  <th style={thStyle}>
                    Total
                  </th>

                  <th style={thStyle}>
                    Status
                  </th>

                  <th style={thStyle}>
                    Actions
                  </th>
                </tr>
              </thead>

              <tbody>
                {flights.map(
                  (flight) => (
                    <tr
                      key={flight.id}
                    >
                      <td style={tdStyle}>
                        {flight.id}
                      </td>

                      <td style={tdStyle}>
                        {flight.flightNumber ||
                          "-"}
                      </td>

                      <td style={tdStyle}>
                        {flight.airlineName ||
                          "-"}
                      </td>

                      <td style={tdStyle}>
                        {getAirportDisplay(
                          flight.sourceAirport
                        )}
                      </td>

                      <td style={tdStyle}>
                        {getAirportDisplay(
                          flight.destinationAirport
                        )}
                      </td>

                      <td style={tdStyle}>
                        ₹
                        {flight.economyPrice ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        ₹
                        {flight.premiumEconomyPrice ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        ₹
                        {flight.businessPrice ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        ₹
                        {flight.firstClassPrice ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        {flight.availableSeats ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        {flight.totalSeats ??
                          52}
                      </td>

                      <td style={tdStyle}>
                        <span
                          style={{
                            padding:
                              "5px 10px",
                            borderRadius:
                              "20px",
                            background:
                              flight.status ===
                              "CANCELLED"
                                ? "#fee2e2"
                                : "#dcfce7",
                            color:
                              flight.status ===
                              "CANCELLED"
                                ? "#b91c1c"
                                : "#15803d",
                            fontWeight:
                              "bold",
                            fontSize:
                              "12px",
                          }}
                        >
                          {flight.status ||
                            "ACTIVE"}
                        </span>
                      </td>

                      <td
                        style={{
                          ...tdStyle,
                          display:
                            "flex",
                          gap: "8px",
                        }}
                      >
                        <button
                          type="button"
                          onClick={() =>
                            handleEditFlight(
                              flight
                            )
                          }
                          style={{
                            padding:
                              "8px 14px",
                            background:
                              "#2563eb",
                            color:
                              "white",
                            border:
                              "none",
                            borderRadius:
                              "6px",
                            cursor:
                              "pointer",
                            fontWeight:
                              "bold",
                          }}
                        >
                          ✏ Edit
                        </button>

                        <button
                          type="button"
                          onClick={() =>
                            handleDeleteFlight(
                              flight.id
                            )
                          }
                          style={{
                            padding:
                              "8px 14px",
                            background:
                              "#dc2626",
                            color:
                              "white",
                            border:
                              "none",
                            borderRadius:
                              "6px",
                            cursor:
                              "pointer",
                            fontWeight:
                              "bold",
                          }}
                        >
                          🗑 Delete
                        </button>
                      </td>
                    </tr>
                  )
                )}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  );
}

