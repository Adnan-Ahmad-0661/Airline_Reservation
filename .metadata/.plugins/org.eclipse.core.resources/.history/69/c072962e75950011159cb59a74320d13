import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

const API_URL = "http://localhost:8080";

function AdminFlights() {
  const navigate = useNavigate();

  const [flights, setFlights] = useState([]);
  const [airports, setAirports] = useState([]);

  const [loading, setLoading] = useState(true);

  const [showForm, setShowForm] = useState(false);
  const [editMode, setEditMode] = useState(false);

  const [editingFlightId, setEditingFlightId] =
    useState(null);

  const [formData, setFormData] = useState({
    flightNumber: "",
    airlineName: "",
    price: "",
    sourceAirportId: "",
    destinationAirportId: "",
    availableSeats: "",
    totalSeats: 52,
  });

  // =========================================
  // FETCH FLIGHTS
  // =========================================

  const fetchFlights = async () => {
    try {
      setLoading(true);

      const response = await fetch(
        `${API_URL}/api/flights`
      );

      if (!response.ok) {
        throw new Error("Unable to fetch flights");
      }

      const data = await response.json();

      console.log("Flights:", data);

      setFlights(data);
    } catch (error) {
      console.error("Fetch flights error:", error);
      alert(error.message);
    } finally {
      setLoading(false);
    }
  };

  // =========================================
  // FETCH AIRPORTS
  // =========================================

  const fetchAirports = async () => {
    try {
      const response = await fetch(
        `${API_URL}/api/airports`
      );

      if (!response.ok) {
        throw new Error("Unable to fetch airports");
      }

      const data = await response.json();

      console.log("Airports:", data);

      setAirports(data);
    } catch (error) {
      console.error("Fetch airports error:", error);

      alert(
        "Airport API nahi mil rahi. AirportController check karo."
      );
    }
  };

  // =========================================
  // LOAD DATA
  // =========================================

  useEffect(() => {
    fetchFlights();
    fetchAirports();
  }, []);

  // =========================================
  // INPUT CHANGE
  // =========================================

  const handleChange = (e) => {
    const { name, value } = e.target;

    setFormData((previous) => ({
      ...previous,
      [name]: value,
    }));
  };

  // =========================================
  // RESET FORM
  // =========================================

  const resetForm = () => {
    setFormData({
      flightNumber: "",
      airlineName: "",
      price: "",
      sourceAirportId: "",
      destinationAirportId: "",
      availableSeats: "",
      totalSeats: 52,
    });

    setEditingFlightId(null);
    setEditMode(false);
    setShowForm(false);
  };

  // =========================================
  // ADD FLIGHT
  // =========================================

  const handleAddFlight = async (e) => {
    e.preventDefault();

    if (
      !formData.flightNumber ||
      !formData.airlineName ||
      !formData.price ||
      !formData.sourceAirportId ||
      !formData.destinationAirportId
    ) {
      alert("Please fill all required fields");
      return;
    }

    if (
      formData.sourceAirportId ===
      formData.destinationAirportId
    ) {
      alert(
        "Source and destination airport cannot be same"
      );
      return;
    }

    try {
      const sourceAirport = airports.find(
        (airport) =>
          Number(airport.id) ===
          Number(formData.sourceAirportId)
      );

      const destinationAirport = airports.find(
        (airport) =>
          Number(airport.id) ===
          Number(formData.destinationAirportId)
      );

      if (!sourceAirport || !destinationAirport) {
        alert("Invalid airport selected");
        return;
      }

      const flight = {
        flightNumber: formData.flightNumber,
        airlineName: formData.airlineName,
        price: Number(formData.price),

        sourceAirport: sourceAirport,
        destinationAirport: destinationAirport,

        availableSeats: Number(
          formData.availableSeats ||
            formData.totalSeats
        ),

        totalSeats: Number(
          formData.totalSeats
        ),
      };

      console.log("Adding flight:", flight);

      const response = await fetch(
        `${API_URL}/api/flights`,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify(flight),
        }
      );

      if (!response.ok) {
        const errorText = await response.text();

        console.error(
          "Add Flight Error:",
          errorText
        );

        throw new Error(
          "Flight creation failed"
        );
      }

      alert("Flight added successfully");

      resetForm();

      await fetchFlights();
    } catch (error) {
      console.error("Add flight error:", error);

      alert(error.message);
    }
  };

  // =========================================
  // EDIT FLIGHT
  // =========================================

  const handleEdit = (flight) => {
    setEditMode(true);
    setShowForm(true);

    setEditingFlightId(flight.id);

    setFormData({
      flightNumber:
        flight.flightNumber || "",

      airlineName:
        flight.airlineName || "",

      price:
        flight.price || "",

      sourceAirportId:
        flight.sourceAirport?.id || "",

      destinationAirportId:
        flight.destinationAirport?.id || "",

      availableSeats:
        flight.availableSeats ?? "",

      totalSeats:
        flight.totalSeats || 52,
    });

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  // =========================================
  // UPDATE FLIGHT
  // =========================================

  const handleUpdateFlight = async (e) => {
    e.preventDefault();

    try {
      const sourceAirport = airports.find(
        (airport) =>
          Number(airport.id) ===
          Number(formData.sourceAirportId)
      );

      const destinationAirport = airports.find(
        (airport) =>
          Number(airport.id) ===
          Number(formData.destinationAirportId)
      );

      if (!sourceAirport || !destinationAirport) {
        alert("Invalid airport selected");
        return;
      }

      const flight = {
        flightNumber: formData.flightNumber,
        airlineName: formData.airlineName,
        price: Number(formData.price),

        sourceAirport: sourceAirport,
        destinationAirport: destinationAirport,

        availableSeats: Number(
          formData.availableSeats
        ),

        totalSeats: Number(
          formData.totalSeats
        ),
      };

      console.log(
        "Updating flight:",
        editingFlightId,
        flight
      );

      const response = await fetch(
        `${API_URL}/api/flights/${editingFlightId}`,
        {
          method: "PUT",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify(flight),
        }
      );

      if (!response.ok) {
        const errorText = await response.text();

        console.error(
          "Update Flight Error:",
          errorText
        );

        throw new Error(
          "Flight update failed"
        );
      }

      alert("Flight updated successfully");

      resetForm();

      await fetchFlights();
    } catch (error) {
      console.error(
        "Update flight error:",
        error
      );

      alert(error.message);
    }
  };

  // =========================================
  // DELETE FLIGHT
  // =========================================

  const handleDelete = async (flightId) => {
    const confirmDelete = window.confirm(
      "Are you sure you want to delete this flight?"
    );

    if (!confirmDelete) {
      return;
    }

    try {
      const response = await fetch(
        `${API_URL}/api/flights/${flightId}`,
        {
          method: "DELETE",
        }
      );

      if (!response.ok) {
        const errorText = await response.text();

        console.error(
          "Delete Flight Error:",
          errorText
        );

        throw new Error(
          "Flight deletion failed"
        );
      }

      alert("Flight deleted successfully");

      await fetchFlights();
    } catch (error) {
      console.error(
        "Delete flight error:",
        error
      );

      alert(error.message);
    }
  };

  // =========================================
  // LOADING
  // =========================================

  if (loading) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif",
        }}
      >
        <h2>Loading Flights...</h2>
      </div>
    );
  }

  // =========================================
  // UI
  // =========================================

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f5f7fa",
        padding: "40px",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <div
        style={{
          maxWidth: "1250px",
          margin: "0 auto",
        }}
      >
        {/* HEADER */}

        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            marginBottom: "30px",
          }}
        >
          <div>
            <h1>✈ Manage Flights</h1>

            <p style={{ color: "#666" }}>
              Add, update and delete flights.
            </p>
          </div>

          <div
            style={{
              display: "flex",
              gap: "10px",
            }}
          >
            <button
              onClick={() => navigate("/admin")}
              style={{
                padding: "11px 20px",
                background: "#374151",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
              }}
            >
              Admin Dashboard
            </button>

            <button
              onClick={() => {
                setShowForm(true);
                setEditMode(false);
              }}
              style={{
                padding: "11px 20px",
                background: "#0066ff",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold",
              }}
            >
              + Add Flight
            </button>
          </div>
        </div>

        {/* FORM */}

        {showForm && (
          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              marginBottom: "30px",
              boxShadow:
                "0 3px 12px rgba(0,0,0,0.08)",
            }}
          >
            <h2>
              {editMode
                ? "✏️ Update Flight"
                : "➕ Add New Flight"}
            </h2>

            <form
              onSubmit={
                editMode
                  ? handleUpdateFlight
                  : handleAddFlight
              }
            >
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "1fr 1fr",
                  gap: "20px",
                }}
              >
                {/* FLIGHT NUMBER */}

                <div>
                  <label>
                    <strong>
                      Flight Number
                    </strong>
                  </label>

                  <input
                    name="flightNumber"
                    value={
                      formData.flightNumber
                    }
                    onChange={handleChange}
                    placeholder="AI101"
                    style={inputStyle}
                  />
                </div>

                {/* AIRLINE */}

                <div>
                  <label>
                    <strong>
                      Airline Name
                    </strong>
                  </label>

                  <input
                    name="airlineName"
                    value={
                      formData.airlineName
                    }
                    onChange={handleChange}
                    placeholder="Air India"
                    style={inputStyle}
                  />
                </div>

                {/* PRICE */}

                <div>
                  <label>
                    <strong>
                      Price
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="price"
                    value={formData.price}
                    onChange={handleChange}
                    placeholder="5500"
                    style={inputStyle}
                  />
                </div>

                {/* TOTAL SEATS */}

                <div>
                  <label>
                    <strong>
                      Total Seats
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="totalSeats"
                    value={
                      formData.totalSeats
                    }
                    onChange={handleChange}
                    style={inputStyle}
                  />
                </div>

                {/* AVAILABLE SEATS */}

                <div>
                  <label>
                    <strong>
                      Available Seats
                    </strong>
                  </label>

                  <input
                    type="number"
                    name="availableSeats"
                    value={
                      formData.availableSeats
                    }
                    onChange={handleChange}
                    placeholder="52"
                    style={inputStyle}
                  />
                </div>

                {/* SOURCE */}

                <div>
                  <label>
                    <strong>
                      Source Airport
                    </strong>
                  </label>

                  <select
                    name="sourceAirportId"
                    value={
                      formData.sourceAirportId
                    }
                    onChange={handleChange}
                    style={inputStyle}
                  >
                    <option value="">
                      Select Source Airport
                    </option>

                    {airports.map(
                      (airport) => (
                        <option
                          key={airport.id}
                          value={airport.id}
                        >
                          {airport.airportCode} -{" "}
                          {airport.city}
                        </option>
                      )
                    )}
                  </select>
                </div>

                {/* DESTINATION */}

                <div>
                  <label>
                    <strong>
                      Destination Airport
                    </strong>
                  </label>

                  <select
                    name="destinationAirportId"
                    value={
                      formData.destinationAirportId
                    }
                    onChange={handleChange}
                    style={inputStyle}
                  >
                    <option value="">
                      Select Destination Airport
                    </option>

                    {airports.map(
                      (airport) => (
                        <option
                          key={airport.id}
                          value={airport.id}
                        >
                          {airport.airportCode} -{" "}
                          {airport.city}
                        </option>
                      )
                    )}
                  </select>
                </div>
              </div>

              {/* FORM BUTTONS */}

              <div
                style={{
                  marginTop: "25px",
                  display: "flex",
                  gap: "10px",
                }}
              >
                <button
                  type="submit"
                  style={{
                    padding: "12px 25px",
                    background: "#16a34a",
                    color: "white",
                    border: "none",
                    borderRadius: "6px",
                    cursor: "pointer",
                    fontWeight: "bold",
                  }}
                >
                  {editMode
                    ? "Update Flight"
                    : "Add Flight"}
                </button>

                <button
                  type="button"
                  onClick={resetForm}
                  style={{
                    padding: "12px 25px",
                    background: "#e5e7eb",
                    border: "none",
                    borderRadius: "6px",
                    cursor: "pointer",
                  }}
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        )}

        {/* FLIGHTS */}

        <div
          style={{
            background: "white",
            borderRadius: "12px",
            padding: "25px",
            boxShadow:
              "0 3px 12px rgba(0,0,0,0.08)",
            overflowX: "auto",
          }}
        >
          <h2>All Flights</h2>

          {flights.length === 0 ? (
            <p>
              No flights available.
            </p>
          ) : (
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                marginTop: "20px",
              }}
            >
              <thead>
                <tr
                  style={{
                    background: "#f3f4f6",
                  }}
                >
                  <th style={thStyle}>
                    ID
                  </th>

                  <th style={thStyle}>
                    Airline
                  </th>

                  <th style={thStyle}>
                    Flight
                  </th>

                  <th style={thStyle}>
                    Route
                  </th>

                  <th style={thStyle}>
                    Price
                  </th>

                  <th style={thStyle}>
                    Seats
                  </th>

                  <th style={thStyle}>
                    Actions
                  </th>
                </tr>
              </thead>

              <tbody>
                {flights.map(
                  (flight) => (
                    <tr
                      key={flight.id}
                      style={{
                        borderBottom:
                          "1px solid #ddd",
                      }}
                    >
                      <td style={tdStyle}>
                        {flight.id}
                      </td>

                      <td style={tdStyle}>
                        {flight.airlineName ||
                          "-"}
                      </td>

                      <td style={tdStyle}>
                        {flight.flightNumber ||
                          "-"}
                      </td>

                      <td style={tdStyle}>
                        {flight.sourceAirport
                          ?.airportCode ||
                          "-"}{" "}
                        →
                        {flight
                          .destinationAirport
                          ?.airportCode ||
                          "-"}
                      </td>

                      <td style={tdStyle}>
                        ₹{flight.price || 0}
                      </td>

                      <td style={tdStyle}>
                        {flight.availableSeats ??
                          0}{" "}
                        /{" "}
                        {flight.totalSeats ??
                          0}
                      </td>

                      <td style={tdStyle}>
                        <div
                          style={{
                            display: "flex",
                            gap: "8px",
                          }}
                        >
                          <button
                            onClick={() =>
                              handleEdit(
                                flight
                              )
                            }
                            style={{
                              padding:
                                "8px 14px",
                              background:
                                "#f59e0b",
                              color:
                                "white",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              cursor:
                                "pointer",
                            }}
                          >
                            Edit
                          </button>

                          <button
                            onClick={() =>
                              handleDelete(
                                flight.id
                              )
                            }
                            style={{
                              padding:
                                "8px 14px",
                              background:
                                "#dc2626",
                              color:
                                "white",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              cursor:
                                "pointer",
                            }}
                          >
                            Delete
                          </button>
                        </div>
                      </td>
                    </tr>
                  )
                )}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  );
}

// =========================================
// STYLES
// =========================================

const inputStyle = {
  width: "100%",
  padding: "11px",
  marginTop: "7px",
  border: "1px solid #d1d5db",
  borderRadius: "6px",
  boxSizing: "border-box",
  fontSize: "15px",
};

const thStyle = {
  padding: "13px",
  textAlign: "left",
  borderBottom: "2px solid #ddd",
};

const tdStyle = {
  padding: "13px",
};

export default AdminFlights;