
import { useEffect, useState } from "react";
import API from "../services/api";

function FlightManagement() {

  const emptyForm = {
    flightNumber: "",
    airlineName: "",
    economyPrice: "",
    premiumEconomyPrice: "",
    businessPrice: "",
    firstClassPrice: "",
    sourceAirportId: "",
    destinationAirportId: "",
    availableSeats: "",
    totalSeats: 52,
    status: "ACTIVE",
  };

  const [flights, setFlights] = useState([]);
  const [airports, setAirports] = useState([]);
  const [form, setForm] = useState(emptyForm);

  const [editingId, setEditingId] = useState(null);
  const [loading, setLoading] = useState(false);

  // =====================================================
  // LOAD FLIGHTS
  // =====================================================

  const loadFlights = async () => {
    try {
      setLoading(true);

      const response = await API.get("/api/flights");

      setFlights(
        Array.isArray(response.data)
          ? response.data
          : []
      );

    } catch (error) {
      console.error("Load Flights Error:", error);

      alert(
        error.response?.data?.message ||
        "Unable to load flights."
      );

    } finally {
      setLoading(false);
    }
  };

  // =====================================================
  // LOAD AIRPORTS
  // =====================================================

  const loadAirports = async () => {

    try {

      const response = await API.get("/api/airports");

      setAirports(
        Array.isArray(response.data)
          ? response.data
          : []
      );

    } catch (error) {

      console.error(
        "Load Airports Error:",
        error
      );

      alert(
        "Unable to load airports."
      );
    }
  };

  // =====================================================
  // INITIAL LOAD
  // =====================================================

  useEffect(() => {

    loadFlights();
    loadAirports();

  }, []);

  // =====================================================
  // INPUT CHANGE
  // =====================================================

  const handleChange = (e) => {

    const { name, value } = e.target;

    setForm((previous) => ({
      ...previous,
      [name]: value,
    }));
  };

  // =====================================================
  // RESET FORM
  // =====================================================

  const resetForm = () => {

    setForm(emptyForm);

    setEditingId(null);
  };

  // =====================================================
  // ADD / UPDATE
  // =====================================================

  const handleSubmit = async (e) => {

    e.preventDefault();

    if (!form.flightNumber.trim()) {
      alert("Please enter flight number.");
      return;
    }

    if (!form.airlineName.trim()) {
      alert("Please enter airline name.");
      return;
    }

    if (!form.sourceAirportId) {
      alert("Please select source airport.");
      return;
    }

    if (!form.destinationAirportId) {
      alert("Please select destination airport.");
      return;
    }

    if (
      form.sourceAirportId ===
      form.destinationAirportId
    ) {
      alert(
        "Source and destination cannot be same."
      );
      return;
    }

    if (
      !form.totalSeats ||
      Number(form.totalSeats) <= 0
    ) {
      alert("Total seats must be greater than 0.");
      return;
    }

    if (
      !form.availableSeats ||
      Number(form.availableSeats) < 0
    ) {
      alert(
        "Available seats cannot be negative."
      );
      return;
    }

    if (
      Number(form.availableSeats) >
      Number(form.totalSeats)
    ) {
      alert(
        "Available seats cannot be greater than total seats."
      );
      return;
    }

    const flightData = {

      flightNumber:
        form.flightNumber.trim(),

      airlineName:
        form.airlineName.trim(),

      economyPrice:
        Number(form.economyPrice || 0),

      premiumEconomyPrice:
        Number(
          form.premiumEconomyPrice || 0
        ),

      businessPrice:
        Number(form.businessPrice || 0),

      firstClassPrice:
        Number(form.firstClassPrice || 0),

      status:
        form.status || "ACTIVE",

      availableSeats:
        Number(form.availableSeats),

      totalSeats:
        Number(form.totalSeats),

      sourceAirport: {
        id: Number(form.sourceAirportId),
      },

      destinationAirport: {
        id: Number(form.destinationAirportId),
      },
    };

    try {

      setLoading(true);

      if (editingId) {

        await API.put(
          `/api/flights/${editingId}`,
          flightData
        );

        alert(
          "Flight updated successfully."
        );

      } else {

        await API.post(
          "/api/flights",
          flightData
        );

        alert(
          "Flight added successfully."
        );
      }

      resetForm();

      await loadFlights();

    } catch (error) {

      console.error(
        "Save Flight Error:",
        error
      );

      alert(
        error.response?.data?.message ||
        error.response?.data ||
        "Unable to save flight."
      );

    } finally {

      setLoading(false);
    }
  };

  // =====================================================
  // EDIT
  // =====================================================

  const handleEdit = (flight) => {

    setEditingId(flight.id);

    setForm({

      flightNumber:
        flight.flightNumber || "",

      airlineName:
        flight.airlineName || "",

      economyPrice:
        flight.economyPrice ?? "",

      premiumEconomyPrice:
        flight.premiumEconomyPrice ?? "",

      businessPrice:
        flight.businessPrice ?? "",

      firstClassPrice:
        flight.firstClassPrice ?? "",

      sourceAirportId:
        flight.sourceAirport?.id
          ? String(flight.sourceAirport.id)
          : "",

      destinationAirportId:
        flight.destinationAirport?.id
          ? String(
              flight.destinationAirport.id
            )
          : "",

      availableSeats:
        flight.availableSeats ?? "",

      totalSeats:
        flight.totalSeats ?? 52,

      status:
        flight.status || "ACTIVE",
    });

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  // =====================================================
  // CANCEL
  // =====================================================

  const handleCancel = async (id) => {

    const confirmCancel =
      window.confirm(
        "Are you sure you want to cancel this flight?"
      );

    if (!confirmCancel) {
      return;
    }

    try {

      setLoading(true);

      await API.put(
        `/api/flights/cancel/${id}`
      );

      alert(
        "Flight cancelled successfully."
      );

      await loadFlights();

    } catch (error) {

      console.error(
        "Cancel Flight Error:",
        error
      );

      alert(
        error.response?.data?.message ||
        error.response?.data ||
        "Unable to cancel flight."
      );

    } finally {

      setLoading(false);
    }
  };

  // =====================================================
  // DELETE
  // =====================================================

  const handleDelete = async (id) => {

    const confirmDelete =
      window.confirm(
        "Are you sure you want to permanently delete this flight?"
      );

    if (!confirmDelete) {
      return;
    }

    try {

      setLoading(true);

      await API.delete(
        `/api/flights/${id}`
      );

      alert(
        "Flight deleted successfully."
      );

      await loadFlights();

    } catch (error) {

      console.error(
        "Delete Flight Error:",
        error
      );

      alert(
        error.response?.data?.message ||
        error.response?.data ||
        "Unable to delete flight."
      );

    } finally {

      setLoading(false);
    }
  };

  // =====================================================
  // AIRPORT NAME
  // =====================================================

  const getAirportName = (airport) => {

    if (!airport) {
      return "--";
    }

    return (
      airport.city ||
      airport.airportName ||
      airport.airportCode ||
      `Airport ${airport.id}`
    );
  };

  // =====================================================
  // UI
  // =====================================================

  return (
    <div
      style={{
        padding: "30px",
        maxWidth: "1400px",
        margin: "0 auto",
      }}
    >

      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: "25px",
        }}
      >

        <h1>
          ✈ Flight Management
        </h1>

        <button
          type="button"
          onClick={resetForm}
          style={buttonStyle("#2563eb")}
        >
          + Add New Flight
        </button>

      </div>

      {/* =================================================
          ADD / UPDATE FORM
      ================================================= */}

      <div
        style={{
          background: "#ffffff",
          padding: "25px",
          borderRadius: "12px",
          boxShadow:
            "0 4px 15px rgba(0,0,0,0.08)",
          marginBottom: "30px",
        }}
      >

        <h2>
          {editingId
            ? "✏️ Update Flight"
            : "➕ Add Flight"}
        </h2>

        <form onSubmit={handleSubmit}>

          <div style={gridStyle}>

            <Input
              label="Flight Number"
              name="flightNumber"
              value={form.flightNumber}
              onChange={handleChange}
              placeholder="AI101"
            />

            <Input
              label="Airline Name"
              name="airlineName"
              value={form.airlineName}
              onChange={handleChange}
              placeholder="Air India"
            />

            <Select
              label="From"
              name="sourceAirportId"
              value={form.sourceAirportId}
              onChange={handleChange}
              airports={airports}
            />

            <Select
              label="To"
              name="destinationAirportId"
              value={
                form.destinationAirportId
              }
              onChange={handleChange}
              airports={airports}
            />

            <Input
              label="Economy Price"
              name="economyPrice"
              type="number"
              value={form.economyPrice}
              onChange={handleChange}
            />

            <Input
              label="Premium Economy Price"
              name="premiumEconomyPrice"
              type="number"
              value={
                form.premiumEconomyPrice
              }
              onChange={handleChange}
            />

            <Input
              label="Business Price"
              name="businessPrice"
              type="number"
              value={form.businessPrice}
              onChange={handleChange}
            />

            <Input
              label="First Class Price"
              name="firstClassPrice"
              type="number"
              value={form.firstClassPrice}
              onChange={handleChange}
            />

            <Input
              label="Total Seats"
              name="totalSeats"
              type="number"
              value={form.totalSeats}
              onChange={handleChange}
            />

            <Input
              label="Available Seats"
              name="availableSeats"
              type="number"
              value={
                form.availableSeats
              }
              onChange={handleChange}
            />

            {editingId && (
              <div>

                <label style={labelStyle}>
                  Status
                </label>

                <select
                  name="status"
                  value={form.status}
                  onChange={handleChange}
                  style={inputStyle}
                >
                  <option value="ACTIVE">
                    ACTIVE
                  </option>

                  <option value="CANCELLED">
                    CANCELLED
                  </option>
                </select>

              </div>
            )}

          </div>

          <div
            style={{
              marginTop: "20px",
              display: "flex",
              gap: "10px",
            }}
          >

            <button
              type="submit"
              disabled={loading}
              style={buttonStyle("#16a34a")}
            >
              {loading
                ? "Saving..."
                : editingId
                ? "Update Flight"
                : "Add Flight"}
            </button>

            {editingId && (
              <button
                type="button"
                onClick={resetForm}
                style={buttonStyle("#6b7280")}
              >
                Cancel Edit
              </button>
            )}

          </div>

        </form>

      </div>

      {/* =================================================
          FLIGHT LIST
      ================================================= */}

      <div
        style={{
          background: "#ffffff",
          padding: "25px",
          borderRadius: "12px",
          boxShadow:
            "0 4px 15px rgba(0,0,0,0.08)",
        }}
      >

        <h2>
          📋 All Flights
        </h2>

        {loading && (
          <p>Loading...</p>
        )}

        {!loading &&
          flights.length === 0 && (
            <p>
              No flights available.
            </p>
          )}

        {!loading &&
          flights.length > 0 && (
            <div
              style={{
                overflowX: "auto",
              }}
            >

              <table
                style={{
                  width: "100%",
                  borderCollapse:
                    "collapse",
                  marginTop: "15px",
                }}
              >

                <thead>

                  <tr>

                    <th style={thStyle}>
                      ID
                    </th>

                    <th style={thStyle}>
                      Flight
                    </th>

                    <th style={thStyle}>
                      Airline
                    </th>

                    <th style={thStyle}>
                      From
                    </th>

                    <th style={thStyle}>
                      To
                    </th>

                    <th style={thStyle}>
                      Seats
                    </th>

                    <th style={thStyle}>
                      Status
                    </th>

                    <th style={thStyle}>
                      Actions
                    </th>

                  </tr>

                </thead>

                <tbody>

                  {flights.map(
                    (flight) => (

                      <tr key={flight.id}>

                        <td style={tdStyle}>
                          {flight.id}
                        </td>

                        <td style={tdStyle}>
                          {flight.flightNumber ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {flight.airlineName ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {getAirportName(
                            flight.sourceAirport
                          )}
                        </td>

                        <td style={tdStyle}>
                          {getAirportName(
                            flight.destinationAirport
                          )}
                        </td>

                        <td style={tdStyle}>
                          {flight.availableSeats ??
                            0}
                          /
                          {flight.totalSeats ??
                            0}
                        </td>

                        <td style={tdStyle}>

                          <span
                            style={{
                              padding:
                                "5px 10px",
                              borderRadius:
                                "20px",
                              fontWeight:
                                "600",
                              background:
                                flight.status ===
                                "CANCELLED"
                                  ? "#fee2e2"
                                  : "#dcfce7",
                              color:
                                flight.status ===
                                "CANCELLED"
                                  ? "#dc2626"
                                  : "#16a34a",
                            }}
                          >
                            {flight.status ||
                              "ACTIVE"}
                          </span>

                        </td>

                        <td style={tdStyle}>

                          <div
                            style={{
                              display:
                                "flex",
                              gap: "7px",
                              flexWrap:
                                "wrap",
                            }}
                          >

                            <button
                              type="button"
                              onClick={() =>
                                handleEdit(
                                  flight
                                )
                              }
                              style={smallButton(
                                "#2563eb"
                              )}
                            >
                              ✏️ Edit
                            </button>

                            {flight.status !==
                              "CANCELLED" && (
                              <button
                                type="button"
                                onClick={() =>
                                  handleCancel(
                                    flight.id
                                  )
                                }
                                style={smallButton(
                                  "#f59e0b"
                                )}
                              >
                                ❌ Cancel
                              </button>
                            )}

                            <button
                              type="button"
                              onClick={() =>
                                handleDelete(
                                  flight.id
                                )
                              }
                              style={smallButton(
                                "#dc2626"
                              )}
                            >
                              🗑 Delete
                            </button>

                          </div>

                        </td>

                      </tr>

                    )
                  )}

                </tbody>

              </table>

            </div>
          )}

      </div>

    </div>
  );
}

// =====================================================
// INPUT COMPONENT
// =====================================================

function Input({
  label,
  name,
  value,
  onChange,
  type = "text",
  placeholder = "",
}) {

  return (
    <div>

      <label style={labelStyle}>
        {label}
      </label>

      <input
        type={type}
        name={name}
        value={value}
        onChange={onChange}
        placeholder={placeholder}
        style={inputStyle}
      />

    </div>
  );
}

// =====================================================
// AIRPORT SELECT
// =====================================================

function Select({
  label,
  name,
  value,
  onChange,
  airports,
}) {

  return (
    <div>

      <label style={labelStyle}>
        {label}
      </label>

      <select
        name={name}
        value={value}
        onChange={onChange}
        style={inputStyle}
      >

        <option value="">
          Select Airport
        </option>

        {airports.map((airport) => (

          <option
            key={airport.id}
            value={airport.id}
          >
            {airport.city ||
              airport.airportName ||
              airport.airportCode}
          </option>

        ))}

      </select>

    </div>
  );
}

// =====================================================
// STYLES
// =====================================================

const gridStyle = {
  display: "grid",
  gridTemplateColumns:
    "repeat(auto-fit, minmax(220px, 1fr))",
  gap: "18px",
};

const labelStyle = {
  display: "block",
  marginBottom: "7px",
  fontWeight: "600",
};

const inputStyle = {
  width: "100%",
  height: "44px",
  padding: "0 12px",
  border: "1px solid #d1d5db",
  borderRadius: "6px",
  fontSize: "15px",
  boxSizing: "border-box",
};

const thStyle = {
  textAlign: "left",
  padding: "12px",
  borderBottom:
    "2px solid #e5e7eb",
  background: "#f8fafc",
};

const tdStyle = {
  padding: "12px",
  borderBottom:
    "1px solid #e5e7eb",
};

const buttonStyle = (background) => ({
  background,
  color: "white",
  border: "none",
  borderRadius: "6px",
  padding: "10px 18px",
  cursor: "pointer",
  fontWeight: "600",
});

const smallButton = (background) => ({
  background,
  color: "white",
  border: "none",
  borderRadius: "5px",
  padding: "7px 10px",
  cursor: "pointer",
  fontWeight: "600",
});

export default FlightManagement;

