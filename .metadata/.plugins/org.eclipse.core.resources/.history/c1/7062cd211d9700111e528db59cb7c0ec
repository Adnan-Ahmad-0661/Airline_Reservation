import { useLocation, useNavigate } from "react-router-dom";
import { useEffect, useState } from "react";

function SeatSelection() {

  const location = useLocation();
  const navigate = useNavigate();

  // =====================================================
  // BOOKING DATA
  // =====================================================

  const bookingData = location.state || {};

  const flight = bookingData.flight;

  const flightId = Number(
    bookingData.flightId ||
    flight?.id ||
    0
  );

  const from =
    bookingData.from ||
    flight?.source ||
    flight?.sourceAirport?.airportCode ||
    "";

  const to =
    bookingData.to ||
    flight?.destination ||
    flight?.destinationAirport?.airportCode ||
    "";

  const travelDate =
    bookingData.travelDate || "";

  const passengers =
    Number(bookingData.passengers) || 1;

  const passengerId =
    Number(bookingData.passengerId) || 0;

  const passengerName =
    bookingData.passengerName || "";

  const passengerAge =
    bookingData.passengerAge || "";

  const passengerGender =
    bookingData.passengerGender || "";

  const passportNumber =
    bookingData.passportNumber || "";


  // =====================================================
  // STATE
  // =====================================================

  const [selectedSeats, setSelectedSeats] =
    useState([]);

  const [seatData, setSeatData] =
    useState([]);

  const [loadingSeats, setLoadingSeats] =
    useState(true);


  // =====================================================
  // GET SEATS BY FLIGHT ID
  // =====================================================

  useEffect(() => {

    if (!flightId) {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setLoadingSeats(false);
      return;
    }

    const fetchSeats = async () => {

      try {

        setLoadingSeats(true);

        const token =
          localStorage.getItem("token");

        const response = await fetch(
          `http://localhost:8080/api/seats/flight/${flightId}`,
          {
            method: "GET",
            headers: {
              "Authorization": `Bearer ${token}`,
              "Content-Type": "application/json"
            }
          }
        );

        if (!response.ok) {

          throw new Error(
            "Unable to fetch seats"
          );
        }

        const data =
          await response.json();

        console.log(
          "SEATS FROM DB:",
          data
        );

        setSeatData(data);

      } catch (error) {

        console.error(
          "Seat fetch error:",
          error
        );

        alert(
          "Unable to load seats from database."
        );

      } finally {

        setLoadingSeats(false);
      }
    };

    fetchSeats();

  }, [flightId]);


  // =====================================================
  // 52 SEATS
  // =====================================================

  const seats = [
    "1A", "1B", "1C", "1D",
    "2A", "2B", "2C", "2D",
    "3A", "3B", "3C", "3D",
    "4A", "4B", "4C", "4D",
    "5A", "5B", "5C", "5D",
    "6A", "6B", "6C", "6D",
    "7A", "7B", "7C", "7D",
    "8A", "8B", "8C", "8D",
    "9A", "9B", "9C", "9D",
    "10A", "10B", "10C", "10D",
    "11A", "11B", "11C", "11D",
    "12A", "12B", "12C", "12D",
    "13A", "13B", "13C", "13D"
  ];


  // =====================================================
  // CHECK WHETHER SEAT IS BOOKED
  // =====================================================

  const isSeatBooked = (seatNumber) => {

    const seat = seatData.find(
      (item) =>
        item.seatNumber === seatNumber
    );

    return (
      seat &&
      seat.status &&
      seat.status.toUpperCase() === "BOOKED"
    );
  };


  // =====================================================
  // AVAILABLE SEATS COUNT
  // =====================================================

  const availableSeats =
    seatData.length > 0
      ? seatData.filter(
          (seat) =>
            seat.status?.toUpperCase() ===
            "AVAILABLE"
        ).length
      : 0;


  // =====================================================
  // SELECT SEAT
  // =====================================================

  const handleSeatClick = (seat) => {

    // BOOKED SEAT
    if (isSeatBooked(seat)) {

      alert(
        `Seat ${seat} is already booked.`
      );

      return;
    }


    // DESELECT
    if (selectedSeats.includes(seat)) {

      setSelectedSeats(
        selectedSeats.filter(
          (item) => item !== seat
        )
      );

      return;
    }


    // MAX SEATS
    if (
      selectedSeats.length >= passengers
    ) {

      alert(
        `You can select maximum ${passengers} seat(s).`
      );

      return;
    }


    // SELECT
    setSelectedSeats([
      ...selectedSeats,
      seat
    ]);
  };


  // =====================================================
  // CONTINUE
  // =====================================================

  const handleContinue = () => {

    if (!flight || !flightId) {

      alert(
        "Flight information is missing. Please select the flight again."
      );

      navigate("/");

      return;
    }


    if (!passengerId) {

      alert(
        "Passenger information is missing. Please enter passenger details again."
      );

      navigate("/booking", {
        state: {
          flight,
          flightId,
          from,
          to,
          travelDate,
          passengers
        }
      });

      return;
    }


    if (
      selectedSeats.length !== passengers
    ) {

      alert(
        `Please select ${passengers} seat(s).`
      );

      return;
    }


    navigate("/payment", {

      state: {

        flight,

        flightId,

        from,

        to,

        travelDate,

        passengers,

        passengerId,

        passengerName,

        passengerAge,

        passengerGender,

        passportNumber,

        selectedSeats
      }
    });
  };


  // =====================================================
  // MISSING INFORMATION
  // =====================================================

  if (
    !flight ||
    !flightId ||
    !passengerId
  ) {

    return (

      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial"
        }}
      >

        <div
          style={{
            background: "white",
            padding: "40px",
            borderRadius: "15px",
            textAlign: "center",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.10)"
          }}
        >

          <h2>
            Booking Information Missing
          </h2>

          <p>
            Please start the booking process again.
          </p>

          <button
            onClick={() => navigate("/")}
            style={{
              padding: "12px 25px",
              background: "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "8px",
              cursor: "pointer"
            }}
          >
            Back to Home
          </button>

        </div>

      </div>
    );
  }


  // =====================================================
  // PRICE
  // =====================================================

  const pricePerSeat =
    Number(flight.price || 0);

  const totalPrice =
    pricePerSeat *
    selectedSeats.length;


  // =====================================================
  // UI
  // =====================================================

  return (

    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef4ff, #f8fafc)",
        padding: "40px 20px",
        fontFamily: "Arial, sans-serif"
      }}
    >

      <div
        style={{
          maxWidth: "1100px",
          margin: "0 auto"
        }}
      >

        {/* HEADER */}

        <div
          style={{
            marginBottom: "25px"
          }}
        >

          <h1>
            Select Your Seats
          </h1>

          <p style={{ color: "#666" }}>
            Select{" "}
            <strong>
              {passengers}
            </strong>{" "}
            seat
            {passengers > 1 ? "s" : ""}
          </p>

        </div>


        {/* FLIGHT INFO */}

        <div
          style={{
            background: "white",
            padding: "20px",
            borderRadius: "12px",
            boxShadow:
              "0 4px 15px rgba(0,0,0,0.07)",
            marginBottom: "25px"
          }}
        >

          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(4, 1fr)",
              gap: "20px"
            }}
          >

            <div>

              <small>
                Airline
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.airlineName ||
                  flight.airline ||
                  "Airline"}
              </strong>

            </div>


            <div>

              <small>
                Flight
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.flightNumber ||
                  "--"}
              </strong>

            </div>


            <div>

              <small>
                Route
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {from} → {to}
              </strong>

            </div>


            <div>

              <small>
                Travel Date
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {travelDate || "--"}
              </strong>

            </div>

          </div>

        </div>


        {/* MAIN */}

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "1.3fr 0.7fr",
            gap: "25px"
          }}
        >

          {/* SEAT AREA */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)"
            }}
          >

            <h2>
              ✈ Aircraft Seats
            </h2>


            {loadingSeats ? (

              <div
                style={{
                  textAlign: "center",
                  padding: "40px"
                }}
              >
                Loading seats...
              </div>

            ) : (

              <>

                <div
                  style={{
                    display: "flex",
                    gap: "25px",
                    marginTop: "15px",
                    marginBottom: "25px"
                  }}
                >

                  <span>
                    Available:{" "}
                    <strong>
                      {availableSeats}
                    </strong>
                  </span>

                  <span>
                    Selected:{" "}
                    <strong>
                      {selectedSeats.length}
                    </strong>
                  </span>

                </div>


                {/* AIRCRAFT */}

                <div
                  style={{
                    maxWidth: "500px",
                    margin: "0 auto"
                  }}
                >

                  <div
                    style={{
                      textAlign: "center",
                      background: "#e5e7eb",
                      padding: "12px",
                      borderRadius:
                        "50% 50% 10px 10px",
                      marginBottom: "20px",
                      fontWeight: "bold"
                    }}
                  >
                    ✈ COCKPIT
                  </div>


                  <div
                    style={{
                      display: "grid",
                      gridTemplateColumns:
                        "1fr 1fr 40px 1fr 1fr",
                      gap: "10px"
                    }}
                  >

                    {seats.map(
                      (seat, index) => {

                        const selected =
                          selectedSeats.includes(
                            seat
                          );

                        const booked =
                          isSeatBooked(
                            seat
                          );

                        const position =
                          index % 4;

                        let gridColumn;

                        if (position === 0) {
                          gridColumn = 1;
                        }
                        else if (position === 1) {
                          gridColumn = 2;
                        }
                        else if (position === 2) {
                          gridColumn = 4;
                        }
                        else {
                          gridColumn = 5;
                        }


                        return (

                          <button
                            key={seat}
                            type="button"
                            disabled={booked}
                            onClick={() =>
                              handleSeatClick(
                                seat
                              )
                            }
                            style={{

                              gridColumn,

                              padding:
                                "12px 5px",

                              border:
                                selected
                                  ? "2px solid #0047b3"
                                  : booked
                                  ? "1px solid #999"
                                  : "1px solid #cbd5e1",

                              borderRadius:
                                "7px",

                              cursor:
                                booked
                                  ? "not-allowed"
                                  : "pointer",

                              background:
                                booked
                                  ? "#9ca3af"
                                  : selected
                                  ? "#0066ff"
                                  : "#e8f0ff",

                              color:
                                booked ||
                                selected
                                  ? "white"
                                  : "#333",

                              fontWeight:
                                "bold",

                              opacity:
                                booked
                                  ? 0.7
                                  : 1
                            }}
                          >

                            {seat}

                            {booked &&
                              " 🔒"}

                          </button>

                        );

                      }
                    )}

                  </div>

                </div>


                {/* LEGEND */}

                <div
                  style={{
                    marginTop: "30px",
                    display: "flex",
                    justifyContent: "center",
                    gap: "25px"
                  }}
                >

                  <span>
                    ⬜ Available
                  </span>

                  <span>
                    🟦 Selected
                  </span>

                  <span>
                    ⬛ Booked
                  </span>

                </div>

              </>

            )}

          </div>


          {/* SUMMARY */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)",
              height: "fit-content"
            }}
          >

            <h2>
              Booking Summary
            </h2>

            <hr />


            <p>
              <strong>
                Passenger:
              </strong>
              <br />
              {passengerName || "--"}
            </p>


            <p>
              <strong>
                Passenger ID:
              </strong>
              <br />
              {passengerId}
            </p>


            <p>
              <strong>
                Flight:
              </strong>
              <br />
              {flight.flightNumber || "--"}
            </p>


            <p>
              <strong>
                Route:
              </strong>
              <br />
              {from} → {to}
            </p>


            <p>
              <strong>
                Date:
              </strong>
              <br />
              {travelDate || "--"}
            </p>


            <hr />


            <h3>
              Selected Seats
            </h3>


            {selectedSeats.length > 0 ? (

              <div
                style={{
                  display: "flex",
                  flexWrap: "wrap",
                  gap: "8px"
                }}
              >

                {selectedSeats.map(
                  (seat) => (

                    <span
                      key={seat}
                      style={{
                        background:
                          "#0066ff",
                        color: "white",
                        padding:
                          "8px 12px",
                        borderRadius: "6px",
                        fontWeight: "bold"
                      }}
                    >
                      {seat}
                    </span>

                  )
                )}

              </div>

            ) : (

              <p
                style={{
                  color: "#777"
                }}
              >
                No seat selected
              </p>

            )}


            <hr />


            <div
              style={{
                background: "#f0f7ff",
                padding: "15px",
                borderRadius: "10px",
                marginTop: "20px"
              }}
            >

              <p
                style={{
                  margin: 0,
                  color: "#666"
                }}
              >
                Total Fare
              </p>

              <h2
                style={{
                  margin: "5px 0 0",
                  color: "#0066ff"
                }}
              >
                ₹{totalPrice}
              </h2>

            </div>


            {/* BUTTONS */}

            <div
              style={{
                display: "flex",
                gap: "10px",
                marginTop: "25px"
              }}
            >

              <button
                type="button"
                onClick={() =>
                  navigate(-1)
                }
                style={{
                  flex: 1,
                  padding: "13px",
                  background: "#e5e7eb",
                  border: "none",
                  borderRadius: "8px",
                  cursor: "pointer",
                  fontWeight: "bold"
                }}
              >
                ← Back
              </button>


              <button
                type="button"
                onClick={handleContinue}
                disabled={
                  loadingSeats ||
                  selectedSeats.length !==
                    passengers
                }
                style={{
                  flex: 2,
                  padding: "13px",

                  background:
                    !loadingSeats &&
                    selectedSeats.length ===
                      passengers
                      ? "#0066ff"
                      : "#9ca3af",

                  color: "white",

                  border: "none",

                  borderRadius: "8px",

                  cursor:
                    !loadingSeats &&
                    selectedSeats.length ===
                      passengers
                      ? "pointer"
                      : "not-allowed",

                  fontWeight: "bold"
                }}
              >
                Continue to Payment →
              </button>

            </div>

          </div>

        </div>

      </div>

    </div>
  );
}

export default SeatSelection;