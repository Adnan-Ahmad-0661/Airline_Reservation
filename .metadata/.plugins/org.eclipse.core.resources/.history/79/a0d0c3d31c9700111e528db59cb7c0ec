import { useLocation, useNavigate } from "react-router-dom";
import { useState, useEffect } from "react";

function SeatSelection() {

  const location = useLocation();
  const navigate = useNavigate();

  // =====================================================
  // GET BOOKING DATA
  // =====================================================

  const bookingData = location.state || {};

  const flight = bookingData.flight;

  const flightId =
    Number(
      bookingData.flightId ||
      flight?.id ||
      0
    );

  const from =
    bookingData.from ||
    flight?.source ||
    "";

  const to =
    bookingData.to ||
    flight?.destination ||
    "";

  const travelDate =
    bookingData.travelDate ||
    "";

  const passengers =
    Number(
      bookingData.passengers
    ) || 1;

  const passengerId =
    Number(
      bookingData.passengerId ||
      0
    );

  const passengerName =
    bookingData.passengerName ||
    "";

  const passengerAge =
    bookingData.passengerAge ||
    "";

  const passengerGender =
    bookingData.passengerGender ||
    "";

  const passportNumber =
    bookingData.passportNumber ||
    "";

  // =====================================================
  // STATE
  // =====================================================

  const [selectedSeats, setSelectedSeats] =
    useState([]);

  const [bookedSeats, setBookedSeats] =
    useState([]);

  const [loadingSeats, setLoadingSeats] =
    useState(true);

  // =====================================================
  // AIRCRAFT SEATS - TOTAL 52
  // =====================================================

  const seats = [
    "1A", "1B", "1C", "1D",
    "2A", "2B", "2C", "2D",
    "3A", "3B", "3C", "3D",
    "4A", "4B", "4C", "4D",
    "5A", "5B", "5C", "5D",
    "6A", "6B", "6C", "6D",
    "7A", "7B", "7C", "7D",
    "8A", "8B", "8C", "8D",
    "9A", "9B", "9C", "9D",
    "10A", "10B", "10C", "10D",
    "11A", "11B", "11C", "11D",
    "12A", "12B", "12C", "12D",
    "13A", "13B", "13C", "13D"
  ];

  // =====================================================
  // GET BOOKED SEATS FROM DATABASE
  // =====================================================

  useEffect(() => {

    if (!flightId) {

      setLoadingSeats(false);

      return;
    }

    const token =
      localStorage.getItem("token");

    fetch(
      `http://localhost:8080/api/seats/flight/${flightId}`,
      {
        method: "GET",

        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json"
        }
      }
    )
      .then(async (response) => {

        if (!response.ok) {

          throw new Error(
            "Unable to fetch seats"
          );
        }

        return response.json();
      })

      .then((data) => {

        console.log(
          "SEATS FROM DATABASE:",
          data
        );

        const booked =
          data
            .filter(
              (seat) =>
                seat.status &&
                seat.status.toUpperCase() ===
                  "BOOKED"
            )
            .map(
              (seat) =>
                seat.seatNumber
            );

        console.log(
          "BOOKED SEATS:",
          booked
        );

        setBookedSeats(booked);
      })

      .catch((error) => {

        console.error(
          "Seat loading error:",
          error
        );

        setBookedSeats([]);
      })

      .finally(() => {

        setLoadingSeats(false);

      });

  }, [flightId]);

  // =====================================================
  // AVAILABLE SEATS COUNT
  // =====================================================

  const availableSeats =
    seats.length - bookedSeats.length;

  // =====================================================
  // SELECT SEAT
  // =====================================================

  const handleSeatClick = (seat) => {

    // ===================================================
    // BOOKED SEAT
    // ===================================================

    if (
      bookedSeats.includes(seat)
    ) {

      alert(
        `Seat ${seat} is already booked.`
      );

      return;
    }

    // ===================================================
    // DESELECT
    // ===================================================

    if (
      selectedSeats.includes(seat)
    ) {

      setSelectedSeats(
        selectedSeats.filter(
          (item) =>
            item !== seat
        )
      );

      return;
    }

    // ===================================================
    // MAX SEATS
    // ===================================================

    if (
      selectedSeats.length >= passengers
    ) {

      alert(
        `You can select maximum ${passengers} seat(s).`
      );

      return;
    }

    // ===================================================
    // SELECT
    // ===================================================

    setSelectedSeats([
      ...selectedSeats,
      seat
    ]);
  };

  // =====================================================
  // CONTINUE TO PAYMENT
  // =====================================================

  const handleContinue = () => {

    // ===================================================
    // FLIGHT CHECK
    // ===================================================

    if (
      !flight ||
      !flightId
    ) {

      console.error(
        "Flight missing:",
        flight
      );

      alert(
        "Flight information is missing. Please select the flight again."
      );

      navigate("/");

      return;
    }

    // ===================================================
    // PASSENGER CHECK
    // ===================================================

    if (!passengerId) {

      console.error(
        "Passenger ID missing:",
        passengerId
      );

      alert(
        "Passenger information is missing. Please enter passenger details again."
      );

      navigate(
        "/booking",
        {
          state: {
            flight,
            flightId,
            from,
            to,
            travelDate,
            passengers
          }
        }
      );

      return;
    }

    // ===================================================
    // SEAT CHECK
    // ===================================================

    if (
      selectedSeats.length === 0
    ) {

      alert(
        "Please select at least one seat."
      );

      return;
    }

    // ===================================================
    // PASSENGER / SEAT COUNT
    // ===================================================

    if (
      selectedSeats.length !== passengers
    ) {

      alert(
        `Please select ${passengers} seat(s) for ${passengers} passenger(s).`
      );

      return;
    }

    // ===================================================
    // FINAL BOOKED SEAT CHECK
    // ===================================================

    const alreadyBooked =
      selectedSeats.some(
        (seat) =>
          bookedSeats.includes(seat)
      );

    if (alreadyBooked) {

      alert(
        "One or more selected seats are already booked. Please select another seat."
      );

      return;
    }

    // ===================================================
    // DEBUG
    // ===================================================

    console.log(
      "=========================================="
    );

    console.log(
      "GOING TO PAYMENT"
    );

    console.log(
      "Flight ID:",
      flightId
    );

    console.log(
      "Flight:",
      flight
    );

    console.log(
      "Passenger ID:",
      passengerId
    );

    console.log(
      "Passenger Name:",
      passengerName
    );

    console.log(
      "Passengers:",
      passengers
    );

    console.log(
      "Booked Seats:",
      bookedSeats
    );

    console.log(
      "Selected Seats:",
      selectedSeats
    );

    console.log(
      "From:",
      from
    );

    console.log(
      "To:",
      to
    );

    console.log(
      "Travel Date:",
      travelDate
    );

    console.log(
      "=========================================="
    );

    // ===================================================
    // GO TO PAYMENT
    // ===================================================

    navigate(
      "/payment",
      {
        state: {

          // FLIGHT
          flight,
          flightId,

          // ROUTE
          from,
          to,

          // DATE
          travelDate,

          // PASSENGERS
          passengers,

          // PASSENGER
          passengerId,
          passengerName,
          passengerAge,
          passengerGender,
          passportNumber,

          // SEATS
          selectedSeats

        }
      }
    );
  };

  // =====================================================
  // MISSING BOOKING INFORMATION
  // =====================================================

  if (
    !flight ||
    !flightId ||
    !passengerId
  ) {

    return (

      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif",
          padding: "20px"
        }}
      >

        <div
          style={{
            background: "white",
            padding: "40px",
            borderRadius: "15px",
            textAlign: "center",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.10)",
            maxWidth: "500px",
            width: "100%"
          }}
        >

          <h2>
            Booking Information Missing
          </h2>

          <p
            style={{
              color: "#666",
              marginTop: "10px"
            }}
          >
            Please start the booking process again.
          </p>

          <button
            type="button"
            onClick={() =>
              navigate("/")
            }
            style={{
              marginTop: "20px",
              padding: "12px 25px",
              background: "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "8px",
              cursor: "pointer",
              fontWeight: "bold"
            }}
          >
            Back to Home
          </button>

        </div>

      </div>
    );
  }

  // =====================================================
  // TOTAL PRICE
  // =====================================================

  const pricePerSeat =
    Number(
      flight.price || 0
    );

  const totalPrice =
    pricePerSeat *
    selectedSeats.length;

  // =====================================================
  // UI
  // =====================================================

  return (

    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef4ff, #f8fafc)",
        padding: "40px 20px",
        fontFamily: "Arial, sans-serif"
      }}
    >

      <div
        style={{
          maxWidth: "1100px",
          margin: "0 auto"
        }}
      >

        {/* =================================================
            HEADER
        ================================================= */}

        <div
          style={{
            marginBottom: "25px"
          }}
        >

          <h1>
            Select Your Seats
          </h1>

          <p
            style={{
              color: "#666"
            }}
          >
            Select{" "}
            <strong>
              {passengers}
            </strong>{" "}
            seat
            {passengers > 1 ? "s" : ""} for your booking.
          </p>

        </div>

        {/* =================================================
            FLIGHT INFORMATION
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "20px",
            borderRadius: "12px",
            boxShadow:
              "0 4px 15px rgba(0,0,0,0.07)",
            marginBottom: "25px"
          }}
        >

          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(4, 1fr)",
              gap: "20px"
            }}
          >

            <div>

              <small
                style={{
                  color: "#777"
                }}
              >
                Airline
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.airlineName ||
                  flight.airline ||
                  "Airline"}
              </strong>

            </div>

            <div>

              <small
                style={{
                  color: "#777"
                }}
              >
                Flight
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.flightNumber ||
                  "--"}
              </strong>

            </div>

            <div>

              <small
                style={{
                  color: "#777"
                }}
              >
                Route
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {from} → {to}
              </strong>

            </div>

            <div>

              <small
                style={{
                  color: "#777"
                }}
              >
                Travel Date
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {travelDate || "--"}
              </strong>

            </div>

          </div>

        </div>

        {/* =================================================
            MAIN CONTENT
        ================================================= */}

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "1.3fr 0.7fr",
            gap: "25px"
          }}
        >

          {/* =================================================
              SEAT AREA
          ================================================= */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)"
            }}
          >

            <h2>
              ✈ Aircraft Seats
            </h2>

            <div
              style={{
                display: "flex",
                gap: "25px",
                marginTop: "15px",
                marginBottom: "25px"
              }}
            >

              <span>
                Available:{" "}
                <strong>
                  {loadingSeats
                    ? "Loading..."
                    : availableSeats}
                </strong>
              </span>

              <span>
                Selected:{" "}
                <strong>
                  {selectedSeats.length}
                </strong>
              </span>

              <span>
                Booked:{" "}
                <strong>
                  {bookedSeats.length}
                </strong>
              </span>

            </div>

            {/* =================================================
                AIRCRAFT
            ================================================= */}

            <div
              style={{
                maxWidth: "500px",
                margin: "0 auto"
              }}
            >

              {/* COCKPIT */}

              <div
                style={{
                  textAlign: "center",
                  background: "#e5e7eb",
                  padding: "12px",
                  borderRadius:
                    "50% 50% 10px 10px",
                  marginBottom: "20px",
                  fontWeight: "bold"
                }}
              >
                ✈ COCKPIT
              </div>

              {/* LOADING */}

              {loadingSeats ? (

                <div
                  style={{
                    textAlign: "center",
                    padding: "30px",
                    color: "#666"
                  }}
                >
                  Loading seats...
                </div>

              ) : (

                /* SEATS */

                <div
                  style={{
                    display: "grid",
                    gridTemplateColumns:
                      "1fr 1fr 40px 1fr 1fr",
                    gap: "10px"
                  }}
                >

                  {seats.map(
                    (seat, index) => {

                      const selected =
                        selectedSeats.includes(
                          seat
                        );

                      const booked =
                        bookedSeats.includes(
                          seat
                        );

                      const position =
                        index % 4;

                      let gridColumn;

                      if (
                        position === 0
                      ) {
                        gridColumn = 1;
                      }
                      else if (
                        position === 1
                      ) {
                        gridColumn = 2;
                      }
                      else if (
                        position === 2
                      ) {
                        gridColumn = 4;
                      }
                      else {
                        gridColumn = 5;
                      }

                      return (

                        <button
                          key={seat}
                          type="button"
                          onClick={() =>
                            handleSeatClick(
                              seat
                            )
                          }
                          disabled={booked}
                          style={{

                            gridColumn,

                            padding:
                              "12px 5px",

                            border:
                              selected
                                ? "2px solid #0047b3"
                                : booked
                                ? "1px solid #777"
                                : "1px solid #cbd5e1",

                            borderRadius:
                              "7px",

                            cursor:
                              booked
                                ? "not-allowed"
                                : "pointer",

                            background:
                              selected
                                ? "#0066ff"
                                : booked
                                ? "#9ca3af"
                                : "#e8f0ff",

                            color:
                              selected ||
                              booked
                                ? "white"
                                : "#333",

                            fontWeight:
                              "bold",

                            opacity:
                              booked
                                ? 0.75
                                : 1
                          }}
                        >

                          {seat}

                        </button>

                      );

                    }
                  )}

                </div>

              )}

            </div>

            {/* =================================================
                LEGEND
            ================================================= */}

            <div
              style={{
                marginTop: "30px",
                display: "flex",
                justifyContent: "center",
                gap: "25px"
              }}
            >

              <span>
                ⬜ Available
              </span>

              <span>
                🟦 Selected
              </span>

              <span>
                ⬛ Booked
              </span>

            </div>

          </div>

          {/* =================================================
              BOOKING SUMMARY
          ================================================= */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)",
              height: "fit-content"
            }}
          >

            <h2>
              Booking Summary
            </h2>

            <hr />

            <p>
              <strong>
                Passenger:
              </strong>
              <br />
              {passengerName || "--"}
            </p>

            <p>
              <strong>
                Passenger ID:
              </strong>
              <br />
              {passengerId}
            </p>

            <p>
              <strong>
                Flight:
              </strong>
              <br />
              {flight.flightNumber ||
                "--"}
            </p>

            <p>
              <strong>
                Route:
              </strong>
              <br />
              {from} → {to}
            </p>

            <p>
              <strong>
                Date:
              </strong>
              <br />
              {travelDate || "--"}
            </p>

            <hr />

            <h3>
              Selected Seats
            </h3>

            {selectedSeats.length > 0 ? (

              <div
                style={{
                  display: "flex",
                  flexWrap: "wrap",
                  gap: "8px"
                }}
              >

                {selectedSeats.map(
                  (seat) => (

                    <span
                      key={seat}
                      style={{
                        background:
                          "#0066ff",
                        color: "white",
                        padding:
                          "8px 12px",
                        borderRadius:
                          "6px",
                        fontWeight:
                          "bold"
                      }}
                    >
                      {seat}
                    </span>

                  )
                )}

              </div>

            ) : (

              <p
                style={{
                  color: "#777"
                }}
              >
                No seat selected
              </p>

            )}

            <hr />

            <div
              style={{
                background: "#f0f7ff",
                padding: "15px",
                borderRadius: "10px",
                marginTop: "20px"
              }}
            >

              <p
                style={{
                  margin: 0,
                  color: "#666"
                }}
              >
                Total Fare
              </p>

              <h2
                style={{
                  margin:
                    "5px 0 0",
                  color: "#0066ff"
                }}
              >
                ₹{totalPrice}
              </h2>

            </div>

            {/* =================================================
                BUTTONS
            ================================================= */}

            <div
              style={{
                display: "flex",
                gap: "10px",
                marginTop: "25px"
              }}
            >

              <button
                type="button"
                onClick={() =>
                  navigate(-1)
                }
                style={{
                  flex: 1,
                  padding: "13px",
                  background:
                    "#e5e7eb",
                  border: "none",
                  borderRadius:
                    "8px",
                  cursor:
                    "pointer",
                  fontWeight:
                    "bold"
                }}
              >
                ← Back
              </button>

              <button
                type="button"
                onClick={
                  handleContinue
                }
                disabled={
                  selectedSeats.length !==
                  passengers ||
                  loadingSeats
                }
                style={{
                  flex: 2,
                  padding: "13px",

                  background:
                    selectedSeats.length ===
                      passengers &&
                    !loadingSeats
                      ? "#0066ff"
                      : "#9ca3af",

                  color: "white",

                  border: "none",

                  borderRadius:
                    "8px",

                  cursor:
                    selectedSeats.length ===
                      passengers &&
                    !loadingSeats
                      ? "pointer"
                      : "not-allowed",

                  fontWeight:
                    "bold"
                }}
              >
                Continue to Payment →
              </button>

            </div>

          </div>

        </div>

      </div>

    </div>
  );
}

export default SeatSelection;