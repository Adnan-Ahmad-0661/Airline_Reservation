import { useEffect, useState } from "react";

const API_URL = "http://localhost:8080";

function AdminDashboard() {

  // =====================================================
  // STATE
  // =====================================================

  const [users, setUsers] = useState([]);
  const [flights, setFlights] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [payments, setPayments] = useState([]);
  const [tickets, setTickets] = useState([]);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  // =====================================================
  // GET TOKEN
  // =====================================================

  const token = localStorage.getItem("token");

  // =====================================================
  // FETCH ADMIN DATA
  // =====================================================

  useEffect(() => {

    const loadAdminData = async () => {

      try {

        setLoading(true);
        setError("");

        const headers = {
          "Content-Type": "application/json"
        };

        if (token) {
          headers.Authorization = `Bearer ${token}`;
        }

        // -----------------------------------------------
        // USERS
        // -----------------------------------------------

        const usersResponse = await fetch(
          `${API_URL}/api/admin/users`,
          {
            method: "GET",
            headers
          }
        );

        if (!usersResponse.ok) {
          throw new Error(
            "Unable to load users"
          );
        }

        const usersData =
          await usersResponse.json();

        // -----------------------------------------------
        // FLIGHTS
        // -----------------------------------------------

        const flightsResponse = await fetch(
          `${API_URL}/api/admin/flights`,
          {
            method: "GET",
            headers
          }
        );

        if (!flightsResponse.ok) {
          throw new Error(
            "Unable to load flights"
          );
        }

        const flightsData =
          await flightsResponse.json();

        // -----------------------------------------------
        // BOOKINGS
        // -----------------------------------------------

        const bookingsResponse = await fetch(
          `${API_URL}/api/admin/bookings`,
          {
            method: "GET",
            headers
          }
        );

        if (!bookingsResponse.ok) {
          throw new Error(
            "Unable to load bookings"
          );
        }

        const bookingsData =
          await bookingsResponse.json();

        // -----------------------------------------------
        // PAYMENTS
        // -----------------------------------------------

        const paymentsResponse = await fetch(
          `${API_URL}/api/admin/payments`,
          {
            method: "GET",
            headers
          }
        );

        if (!paymentsResponse.ok) {
          throw new Error(
            "Unable to load payments"
          );
        }

        const paymentsData =
          await paymentsResponse.json();

        // -----------------------------------------------
        // TICKETS
        // -----------------------------------------------

        const ticketsResponse = await fetch(
          `${API_URL}/api/admin/tickets`,
          {
            method: "GET",
            headers
          }
        );

        if (!ticketsResponse.ok) {
          throw new Error(
            "Unable to load tickets"
          );
        }

        const ticketsData =
          await ticketsResponse.json();

        // -----------------------------------------------
        // SET DATA
        // -----------------------------------------------

        setUsers(
          Array.isArray(usersData)
            ? usersData
            : []
        );

        setFlights(
          Array.isArray(flightsData)
            ? flightsData
            : []
        );

        setBookings(
          Array.isArray(bookingsData)
            ? bookingsData
            : []
        );

        setPayments(
          Array.isArray(paymentsData)
            ? paymentsData
            : []
        );

        setTickets(
          Array.isArray(ticketsData)
            ? ticketsData
            : []
        );

      } catch (err) {

        console.error(
          "Admin Dashboard Error:",
          err
        );

        setError(
          err.message ||
          "Unable to load admin dashboard."
        );

      } finally {

        setLoading(false);

      }
    };

    loadAdminData();

  }, [token]);

  // =====================================================
  // LOADING
  // =====================================================

  if (loading) {

    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          fontFamily: "Arial, sans-serif",
          background: "#f5f7fa"
        }}
      >

        <h2>
          Loading Admin Dashboard...
        </h2>

      </div>
    );
  }

  // =====================================================
  // ERROR
  // =====================================================

  if (error) {

    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif"
        }}
      >

        <div
          style={{
            background: "white",
            padding: "35px",
            borderRadius: "15px",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.10)",
            textAlign: "center"
          }}
        >

          <h2>
            Admin Dashboard Error
          </h2>

          <p
            style={{
              color: "red"
            }}
          >
            {error}
          </p>

        </div>

      </div>
    );
  }

  // =====================================================
  // DASHBOARD
  // =====================================================

  return (

    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef4ff, #f8fafc)",
        padding: "30px",
        fontFamily: "Arial, sans-serif"
      }}
    >

      <div
        style={{
          maxWidth: "1300px",
          margin: "auto"
        }}
      >

        {/* =================================================
            HEADER
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "25px 30px",
            borderRadius: "15px",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.08)",
            marginBottom: "25px"
          }}
        >

          <h1
            style={{
              margin: 0
            }}
          >
            ✈️ Admin Dashboard
          </h1>

          <p
            style={{
              color: "#666",
              marginBottom: 0
            }}
          >
            Airline Reservation System
          </p>

        </div>


        {/* =================================================
            STAT CARDS
        ================================================= */}

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "repeat(5, 1fr)",
            gap: "18px",
            marginBottom: "30px"
          }}
        >

          {/* USERS */}

          <div
            style={{
              background: "white",
              padding: "22px",
              borderRadius: "14px",
              boxShadow:
                "0 5px 15px rgba(0,0,0,0.07)"
            }}
          >

            <p
              style={{
                color: "#777",
                margin: 0
              }}
            >
              Total Users
            </p>

            <h2>
              👥 {users.length}
            </h2>

          </div>


          {/* FLIGHTS */}

          <div
            style={{
              background: "white",
              padding: "22px",
              borderRadius: "14px",
              boxShadow:
                "0 5px 15px rgba(0,0,0,0.07)"
            }}
          >

            <p
              style={{
                color: "#777",
                margin: 0
              }}
            >
              Total Flights
            </p>

            <h2>
              ✈️ {flights.length}
            </h2>

          </div>


          {/* BOOKINGS */}

          <div
            style={{
              background: "white",
              padding: "22px",
              borderRadius: "14px",
              boxShadow:
                "0 5px 15px rgba(0,0,0,0.07)"
            }}
          >

            <p
              style={{
                color: "#777",
                margin: 0
              }}
            >
              Total Bookings
            </p>

            <h2>
              🎫 {bookings.length}
            </h2>

          </div>


          {/* PAYMENTS */}

          <div
            style={{
              background: "white",
              padding: "22px",
              borderRadius: "14px",
              boxShadow:
                "0 5px 15px rgba(0,0,0,0.07)"
            }}
          >

            <p
              style={{
                color: "#777",
                margin: 0
              }}
            >
              Total Payments
            </p>

            <h2>
              💳 {payments.length}
            </h2>

          </div>


          {/* TICKETS */}

          <div
            style={{
              background: "white",
              padding: "22px",
              borderRadius: "14px",
              boxShadow:
                "0 5px 15px rgba(0,0,0,0.07)"
            }}
          >

            <p
              style={{
                color: "#777",
                margin: 0
              }}
            >
              Total Tickets
            </p>

            <h2>
              🎟️ {tickets.length}
            </h2>

          </div>

        </div>


        {/* =================================================
            FLIGHTS
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "25px",
            borderRadius: "15px",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.08)",
            marginBottom: "25px"
          }}
        >

          <h2>
            ✈️ All Flights
          </h2>

          <div
            style={{
              overflowX: "auto"
            }}
          >

            <table
              style={{
                width: "100%",
                borderCollapse: "collapse"
              }}
            >

              <thead>

                <tr
                  style={{
                    background: "#eef4ff"
                  }}
                >

                  <th style={thStyle}>
                    ID
                  </th>

                  <th style={thStyle}>
                    Flight
                  </th>

                  <th style={thStyle}>
                    Airline
                  </th>

                  <th style={thStyle}>
                    Source
                  </th>

                  <th style={thStyle}>
                    Destination
                  </th>

                  <th style={thStyle}>
                    Price
                  </th>

                  <th style={thStyle}>
                    Status
                  </th>

                </tr>

              </thead>

              <tbody>

                {flights.length === 0 ? (

                  <tr>

                    <td
                      colSpan="7"
                      style={{
                        textAlign: "center",
                        padding: "25px"
                      }}
                    >
                      No flights found
                    </td>

                  </tr>

                ) : (

                  flights.map(
                    (flight) => (

                      <tr key={flight.id}>

                        <td style={tdStyle}>
                          {flight.id}
                        </td>

                        <td style={tdStyle}>
                          {flight.flightNumber ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {flight.airlineName ||
                            flight.airline ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {flight.source ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {flight.destination ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          ₹{flight.price || 0}
                        </td>

                        <td style={tdStyle}>
                          {flight.status ||
                            "ACTIVE"}
                        </td>

                      </tr>

                    )
                  )

                )}

              </tbody>

            </table>

          </div>

        </div>


        {/* =================================================
            BOOKINGS
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "25px",
            borderRadius: "15px",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.08)",
            marginBottom: "25px"
          }}
        >

          <h2>
            🎫 All Bookings
          </h2>

          <div
            style={{
              overflowX: "auto"
            }}
          >

            <table
              style={{
                width: "100%",
                borderCollapse: "collapse"
              }}
            >

              <thead>

                <tr
                  style={{
                    background: "#eef4ff"
                  }}
                >

                  <th style={thStyle}>
                    ID
                  </th>

                  <th style={thStyle}>
                    PNR
                  </th>

                  <th style={thStyle}>
                    Seat
                  </th>

                  <th style={thStyle}>
                    Status
                  </th>

                  <th style={thStyle}>
                    Flight
                  </th>

                </tr>

              </thead>

              <tbody>

                {bookings.length === 0 ? (

                  <tr>

                    <td
                      colSpan="5"
                      style={{
                        textAlign: "center",
                        padding: "25px"
                      }}
                    >
                      No bookings found
                    </td>

                  </tr>

                ) : (

                  bookings.map(
                    (booking) => (

                      <tr key={booking.id}>

                        <td style={tdStyle}>
                          {booking.id}
                        </td>

                        <td style={tdStyle}>
                          {booking.pnr ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {booking.seatNumber ||
                            booking.seat?.seatNumber ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {booking.status ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {booking.flight?.flightNumber ||
                            booking.flightId ||
                            "--"}
                        </td>

                      </tr>

                    )
                  )

                )}

              </tbody>

            </table>

          </div>

        </div>


        {/* =================================================
            USERS
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "25px",
            borderRadius: "15px",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.08)",
            marginBottom: "25px"
          }}
        >

          <h2>
            👥 All Users
          </h2>

          <div
            style={{
              overflowX: "auto"
            }}
          >

            <table
              style={{
                width: "100%",
                borderCollapse: "collapse"
              }}
            >

              <thead>

                <tr
                  style={{
                    background: "#eef4ff"
                  }}
                >

                  <th style={thStyle}>
                    ID
                  </th>

                  <th style={thStyle}>
                    Name
                  </th>

                  <th style={thStyle}>
                    Email
                  </th>

                  <th style={thStyle}>
                    Role
                  </th>

                </tr>

              </thead>

              <tbody>

                {users.length === 0 ? (

                  <tr>

                    <td
                      colSpan="4"
                      style={{
                        textAlign: "center",
                        padding: "25px"
                      }}
                    >
                      No users found
                    </td>

                  </tr>

                ) : (

                  users.map(
                    (user) => (

                      <tr key={user.id}>

                        <td style={tdStyle}>
                          {user.id}
                        </td>

                        <td style={tdStyle}>
                          {user.name ||
                            user.username ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {user.email ||
                            "--"}
                        </td>

                        <td style={tdStyle}>
                          {user.role ||
                            "--"}
                        </td>

                      </tr>

                    )
                  )

                )}

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </div>
  );
}


// =====================================================
// TABLE STYLES
// =====================================================

const thStyle = {
  padding: "12px",
  textAlign: "left",
  borderBottom:
    "1px solid #ddd"
};

const tdStyle = {
  padding: "12px",
  borderBottom:
    "1px solid #eee"
};


export default AdminDashboard;