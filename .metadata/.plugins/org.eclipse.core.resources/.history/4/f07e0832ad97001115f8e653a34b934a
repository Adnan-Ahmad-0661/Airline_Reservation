import { useState } from "react";
import { useNavigate } from "react-router-dom";
import API from "../services/api";
import "./Home.css";

function Home() {

  const navigate = useNavigate();

  // =====================================================
  // LOGIN STATUS
  // =====================================================

  const [isLoggedIn, setIsLoggedIn] = useState(
    !!localStorage.getItem("token")
  );

  // =====================================================
  // AIRPORT / CITY LIST
  // =====================================================

  const airports = [
    "Delhi",
    "Ayodhya",
    "Gorakhpur",
    "Bangalore",
    "Lucknow",
    "Mumbai",
    "Kolkata",
    "Chennai",
    "Hyderabad",
    "Ahmedabad",
    "Pune",
    "Jaipur",
    "Patna",
    "Varanasi",
    "Goa"
  ];

  // =====================================================
  // SEARCH STATES
  // =====================================================

  const [from, setFrom] = useState("");
  const [to, setTo] = useState("");
  const [date, setDate] = useState("");
  const [passengers, setPassengers] = useState(1);

  const [flights, setFlights] = useState([]);
  const [loading, setLoading] = useState(false);
  const [searched, setSearched] = useState(false);

  // =====================================================
  // CHECK LOGIN
  // =====================================================

  const requireLogin = (action) => {

    const token = localStorage.getItem("token");

    if (!token) {

      setIsLoggedIn(false);

      alert(
        "Please login first to access this feature."
      );

      navigate("/login");

      return;
    }

    setIsLoggedIn(true);

    if (action) {
      action();
    }
  };

  // =====================================================
  // EASY BOOKING
  // =====================================================

  const handleEasyBooking = () => {

    requireLogin(() => {

      const searchSection =
        document.querySelector(".search-card");

      if (searchSection) {

        searchSection.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });

      }

    });
  };

  // =====================================================
  // SECURE
  // =====================================================

  const handleSecure = () => {

    requireLogin(() => {

      alert(
        "🔒 Your account and booking information is protected with JWT authentication."
      );

    });
  };

  // =====================================================
  // MY BOOKINGS
  // =====================================================

  const handleMyBookings = () => {

    requireLogin(() => {

      navigate("/my-bookings");

    });
  };

  // =====================================================
  // TODAY DATE
  // =====================================================

  const getTodayDate = () => {

    const today = new Date();

    const year = today.getFullYear();

    const month = String(
      today.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
      today.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
  };

  // =====================================================
  // MAX BOOKING DATE
  // TODAY + 3 MONTHS
  // =====================================================

  const getMaxBookingDate = () => {

    const today = new Date();

    const maxDate = new Date(
      today.getFullYear(),
      today.getMonth() + 3,
      today.getDate()
    );

    const year = maxDate.getFullYear();

    const month = String(
      maxDate.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
      maxDate.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
  };

  // =====================================================
  // LOGOUT
  // =====================================================

  const handleLogout = () => {

    const confirmLogout = window.confirm(
      "Are you sure you want to logout?"
    );

    if (!confirmLogout) {
      return;
    }

    localStorage.removeItem("token");
    localStorage.removeItem("userId");
    localStorage.removeItem("userName");
    localStorage.removeItem("userEmail");
    localStorage.removeItem("userRole");
    localStorage.removeItem("user");

    setIsLoggedIn(false);

    setFlights([]);
    setSearched(false);

    navigate("/");

    alert("Logout successful.");
  };

  // =====================================================
  // SEARCH FLIGHTS
  // =====================================================

  const searchFlights = async () => {

    const source = from.trim();
    const destination = to.trim();

    // SOURCE
    if (!source) {

      alert(
        "Please select departure city."
      );

      return;
    }

    // DESTINATION
    if (!destination) {

      alert(
        "Please select destination city."
      );

      return;
    }

    // SAME CITY
    if (
      source.toLowerCase() ===
      destination.toLowerCase()
    ) {

      alert(
        "Source and destination cannot be same."
      );

      return;
    }

    // PASSENGERS
    if (
      passengers < 1 ||
      passengers > 10
    ) {

      alert(
        "Passengers must be between 1 and 10."
      );

      return;
    }

    // DATE
    if (!date) {

      alert(
        "Please select a travel date."
      );

      return;
    }

    // DATE RANGE

    const today = getTodayDate();
    const maxDate = getMaxBookingDate();

    if (date < today) {

      alert(
        "Past date is not allowed."
      );

      setDate("");

      return;
    }

    if (date > maxDate) {

      alert(
        "You can book flights only within the next 3 months."
      );

      setDate("");

      return;
    }

    // =================================================
    // API CALL
    // =================================================

    try {

      setLoading(true);
      setSearched(true);
      setFlights([]);

      const params = {
        source: source,
        destination: destination,
        date: date
      };

      const response =
        await API.get(
          "/api/flights/search",
          {
            params: params
          }
        );

      const result =
        Array.isArray(response.data)
          ? response.data
          : [];

      setFlights(result);

    } catch (error) {

      console.error(
        "Flight Search Error:",
        error
      );

      setFlights([]);

      if (error.response) {

        alert(
          error.response.data?.message ||
          "Unable to search flights."
        );

      } else {

        alert(
          "Unable to connect to backend."
        );

      }

    } finally {

      setLoading(false);

    }
  };

  // =====================================================
  // BOOK FLIGHT
  // =====================================================

  const bookFlight = (flight) => {

    const token =
      localStorage.getItem("token");

    if (!token) {

      setIsLoggedIn(false);

      alert(
        "Please login first to continue booking."
      );

      navigate("/login");

      return;
    }

    setIsLoggedIn(true);

    if (!flight) {

      alert(
        "Flight information is missing."
      );

      return;
    }

    if (!flight.id) {

      console.error(
        "Flight does not contain ID:",
        flight
      );

      alert(
        "Flight ID is missing."
      );

      return;
    }

    // =================================================
    // NORMALIZE FLIGHT
    // =================================================

    const selectedFlight = {

      ...flight,

      id: Number(
        flight.id
      ),

      airlineName:
        flight.airlineName ||
        flight.airline ||
        "Airline",

      flightNumber:
        flight.flightNumber ||
        flight.flightNo ||
        "--",

      source:
        flight.source ||
        flight.sourceAirport?.city ||
        from,

      destination:
        flight.destination ||
        flight.destinationAirport?.city ||
        to,

      departureTime:
        flight.departureTime ||
        flight.departure ||
        "--",

      arrivalTime:
        flight.arrivalTime ||
        flight.arrival ||
        "--",

      // =================================================
      // PRICE
      // =================================================
      // Price is stored here but NOT displayed on Home.
      // SeatSelection will use this price after seats
      // are selected.

      price: Number(
        flight.price ??
        flight.economyPrice ??
        0
      ),

      economyPrice: Number(
        flight.economyPrice ??
        flight.price ??
        0
      ),

      premiumEconomyPrice: Number(
        flight.premiumEconomyPrice ??
        0
      ),

      businessPrice: Number(
        flight.businessPrice ??
        0
      ),

      firstClassPrice: Number(
        flight.firstClassPrice ??
        0
      ),

      availableSeats:
        flight.availableSeats ??
        flight.seatsAvailable ??
        0,

      totalSeats:
        flight.totalSeats ??
        52
    };

    console.log(
      "Selected Flight:",
      selectedFlight
    );

    // =================================================
    // GO TO BOOKING
    // =================================================

    navigate(
      "/booking",
      {
        state: {

          flight:
            selectedFlight,

          flightId:
            selectedFlight.id,

          from:
            selectedFlight.source,

          to:
            selectedFlight.destination,

          travelDate:
            date,

          passengers:
            Number(passengers)

        }
      }
    );
  };

  // =====================================================
  // UI
  // =====================================================

  return (

    <div className="home">

      {/* =================================================
          NAVBAR
      ================================================= */}

      <nav className="navbar">

        <div
          className="logo"
          style={{
            fontWeight: "800",
            color: "#1d4ed8"
          }}
        >
          ✈ Airline Reservation
        </div>

        <div className="nav-links">

          {/* HOME */}

          <button
            type="button"
            onClick={() =>
              navigate("/")
            }
            style={{
              ...navButtonStyle,
              background: "#2563eb",
              color: "white",
              padding: "9px 16px",
              borderRadius: "6px"
            }}
          >
            🏠 Home
          </button>

          {/* MY BOOKINGS */}

          <button
            type="button"
            onClick={handleMyBookings}
            style={{
              ...navButtonStyle,
              background: "#7c3aed",
              color: "white",
              padding: "9px 16px",
              borderRadius: "6px"
            }}
          >
            📋 My Bookings
          </button>

          {/* CREATE USER */}

          <button
            type="button"
            onClick={() =>
              navigate("/create-user")
            }
            style={{
              ...navButtonStyle,
              background: "#16a34a",
              color: "white",
              padding: "9px 16px",
              borderRadius: "6px"
            }}
          >
            👤 Create User
          </button>

          {/* LOGIN / LOGOUT */}

          {!isLoggedIn ? (

            <button
              type="button"
              onClick={() =>
                navigate("/login")
              }
              style={{
                ...navButtonStyle,
                background: "#0066ff",
                color: "white",
                padding: "9px 18px",
                borderRadius: "6px"
              }}
            >
              Login
            </button>

          ) : (

            <button
              type="button"
              onClick={handleLogout}
              style={{
                ...navButtonStyle,
                background: "#dc2626",
                color: "white",
                padding: "9px 18px",
                borderRadius: "6px"
              }}
            >
              Logout
            </button>

          )}

        </div>

      </nav>

      {/* =================================================
          HERO
      ================================================= */}

      <section className="hero">

        <div className="hero-content">

          <h1
            style={{
              marginBottom: "12px",
              color: "#1d4ed8"
            }}
          >
            Book Your Flight
          </h1>

          <p
            style={{
              marginTop: "0",
              color: "#4b5563"
            }}
          >
            Search and book flights easily with
            our Airline Reservation System
          </p>

          {/* SEARCH CARD */}

          <div className="search-card">

            {/* FROM */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                From
              </label>

              <select
                value={from}
                onChange={(e) =>
                  setFrom(e.target.value)
                }
                style={selectStyle}
              >

                <option value="">
                  Select departure city
                </option>

                {airports.map(
                  (airport) => (

                    <option
                      key={airport}
                      value={airport}
                    >
                      {airport}
                    </option>

                  )
                )}

              </select>

            </div>

            {/* TO */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                To
              </label>

              <select
                value={to}
                onChange={(e) =>
                  setTo(e.target.value)
                }
                style={selectStyle}
              >

                <option value="">
                  Select destination city
                </option>

                {airports.map(
                  (airport) => (

                    <option
                      key={airport}
                      value={airport}
                    >
                      {airport}
                    </option>

                  )
                )}

              </select>

            </div>

            {/* DATE */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                Date
              </label>

              <input
                type="date"
                value={date}
                min={getTodayDate()}
                max={getMaxBookingDate()}
                onChange={(e) =>
                  setDate(e.target.value)
                }
                style={inputStyle}
              />

            </div>

            {/* PASSENGERS */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                Passengers
              </label>

              <select
                value={passengers}
                onChange={(e) =>
                  setPassengers(
                    Number(e.target.value)
                  )
                }
                style={selectStyle}
              >

                {Array.from(
                  {
                    length: 10
                  },
                  (_, index) =>
                    index + 1
                ).map(
                  (number) => (

                    <option
                      key={number}
                      value={number}
                    >
                      {number}
                    </option>

                  )
                )}

              </select>

            </div>

            {/* SEARCH */}

            <button
              type="button"
              className="search-btn"
              onClick={searchFlights}
              disabled={loading}
            >
              {loading
                ? "Searching..."
                : "Search Flights"}
            </button>

          </div>

        </div>

      </section>

      {/* =================================================
          FEATURES
      ================================================= */}

      {!searched && (

        <section className="features">

          <div className="feature-card">

            <h3>
              ✈ Easy Booking
            </h3>

            <p>
              Search and book your preferred
              flights quickly and easily.
            </p>

            <button
              type="button"
              onClick={handleEasyBooking}
              style={{
                marginTop: "10px",
                padding: "10px 18px",
                background: "#0066ff",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold"
              }}
            >
              ✈ Start Booking
            </button>

          </div>

          <div className="feature-card">

            <h3>
              🔒 Secure
            </h3>

            <p>
              Your account and booking information
              is protected with JWT authentication.
            </p>

            <button
              type="button"
              onClick={handleSecure}
              style={{
                marginTop: "10px",
                padding: "10px 18px",
                background: "#7c3aed",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold"
              }}
            >
              🔒 View Security
            </button>

          </div>

          <div className="feature-card">

            <h3>
              📋 My Bookings
            </h3>

            <p>
              View and manage your flight
              bookings in one place.
            </p>

            <button
              type="button"
              onClick={handleMyBookings}
              style={{
                marginTop: "10px",
                padding: "10px 18px",
                background: "#f59e0b",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold"
              }}
            >
              📋 View Bookings
            </button>

          </div>

          <div className="feature-card">

            <h3>
              👤 Create Account
            </h3>

            <p>
              Create your airline reservation
              account to book flights.
            </p>

            <button
              type="button"
              onClick={() =>
                navigate("/create-user")
              }
              style={{
                marginTop: "10px",
                padding: "10px 18px",
                background: "#16a34a",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold"
              }}
            >
              👤 Create User
            </button>

          </div>

        </section>

      )}

      {/* =================================================
          FLIGHT RESULTS
      ================================================= */}

      {searched && (

        <section className="flight-results">

          <h2>
            Available Flights
          </h2>

          <p className="route">

            {from || "--"}
            {" → "}
            {to || "--"}

            {date && (
              <>
                {" | "}
                {date}
              </>
            )}

            {" | "}
            {passengers}
            {" Passenger(s)"}

          </p>

          {/* LOADING */}

          {loading && (

            <div
              style={{
                textAlign: "center",
                padding: "30px"
              }}
            >
              <p>
                Searching flights...
              </p>
            </div>

          )}

          {/* NO FLIGHTS */}

          {!loading &&
            flights.length === 0 && (

              <div
                style={{
                  textAlign: "center",
                  padding: "30px"
                }}
              >

                <h3>
                  No flights available
                </h3>

                <p>

                  No flights found from{" "}

                  <strong>
                    {from}
                  </strong>

                  {" "}to{" "}

                  <strong>
                    {to}
                  </strong>

                  {" "}for{" "}

                  <strong>
                    {date}
                  </strong>.

                </p>

              </div>

            )}

          {/* FLIGHT LIST */}

          {!loading &&
            flights.length > 0 && (

              <div className="flight-list">

                {flights.map(
                  (flight) => {

                    const airlineName =
                      flight.airlineName ||
                      flight.airline ||
                      "Airline";

                    const flightNumber =
                      flight.flightNumber ||
                      flight.flightNo ||
                      "--";

                    const source =
                      flight.source ||
                      flight.sourceAirport?.city ||
                      from ||
                      "--";

                    const destination =
                      flight.destination ||
                      flight.destinationAirport?.city ||
                      to ||
                      "--";

                    const departureTime =
                      flight.departureTime ||
                      flight.departure ||
                      "--";

                    const arrivalTime =
                      flight.arrivalTime ||
                      flight.arrival ||
                      "--";

                    const availableSeats =
                      flight.availableSeats ??
                      flight.seatsAvailable ??
                      0;

                    return (

                      <div
                        className="flight-card"
                        key={flight.id}
                      >

                        {/* AIRLINE */}

                        <div>

                          <h3>
                            {airlineName}
                          </h3>

                          <p>
                            {flightNumber}
                          </p>

                        </div>

                        {/* SOURCE */}

                        <div>

                          <h3>
                            {departureTime}
                          </h3>

                          <p>
                            {source}
                          </p>

                        </div>

                        {/* ARROW */}

                        <div className="arrow">
                          →
                        </div>

                        {/* DESTINATION */}

                        <div>

                          <h3>
                            {arrivalTime}
                          </h3>

                          <p>
                            {destination}
                          </p>

                        </div>

                        {/* =================================================
                            FARE
                            PRICE IS INTENTIONALLY NOT SHOWN HERE
                        ================================================= */}

                        <div
                          style={{
                            textAlign: "center"
                          }}
                        >

                          <p
                            style={{
                              color: "#6b7280",
                              fontSize: "15px",
                              margin: "0 0 8px"
                            }}
                          >
                            Select seat to view fare
                          </p>

                          <p
                            style={{
                              color: "#555",
                              fontSize: "13px",
                              margin: "0 0 12px"
                            }}
                          >
                            Seats: {availableSeats}
                          </p>

                          <button
                            type="button"
                            className="book-btn"
                            onClick={() =>
                              bookFlight(flight)
                            }
                          >
                            Book Now
                          </button>

                        </div>

                      </div>

                    );

                  }
                )}

              </div>

            )}

        </section>

      )}

    </div>
  );
}

// =====================================================
// NAV BUTTON STYLE
// =====================================================

const navButtonStyle = {

  border: "none",

  background: "transparent",

  cursor: "pointer",

  fontSize: "15px",

  fontWeight: "600",

  padding: "8px 12px"

};

// =====================================================
// FIELD STYLE
// =====================================================

const fieldStyle = {

  display: "flex",

  flexDirection: "column",

  justifyContent: "flex-start",

  minHeight: "80px",

  flex: "1"

};

// =====================================================
// LABEL STYLE
// =====================================================

const labelStyle = {

  display: "block",

  marginBottom: "8px",

  fontSize: "18px",

  fontWeight: "700",

  lineHeight: "24px"

};

// =====================================================
// SELECT STYLE
// =====================================================

const selectStyle = {

  width: "100%",

  height: "52px",

  padding: "0 12px",

  border: "1px solid #ccc",

  borderRadius: "6px",

  fontSize: "16px",

  boxSizing: "border-box",

  background: "white",

  cursor: "pointer",

  outline: "none"

};

// =====================================================
// DATE INPUT STYLE
// =====================================================

const inputStyle = {

  width: "100%",

  height: "52px",

  padding: "0 12px",

  border: "1px solid #ccc",

  borderRadius: "6px",

  fontSize: "16px",

  boxSizing: "border-box",

  background: "white",

  cursor: "pointer",

  outline: "none"

};

export default Home;