package com.airline.reservation.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.airline.reservation.entity.Airport;
import com.airline.reservation.entity.Flight;
import com.airline.reservation.repository.AirportRepository;
import com.airline.reservation.repository.BookingRepository;
import com.airline.reservation.repository.FlightRepository;
import com.airline.reservation.service.FlightService;

@Service
public class FlightServiceImpl implements FlightService {

    @Autowired
    private FlightRepository flightRepository;

    @Autowired
    private BookingRepository bookingRepository;

    @Autowired
    private AirportRepository airportRepository;

    // =====================================================
    // ADD FLIGHT
    // =====================================================

    @Override
    public Flight addFlight(Flight flight) {

        if (flight == null) {
            throw new RuntimeException(
                "Flight data is required"
            );
        }

        if (flight.getSourceAirport() == null ||
            flight.getSourceAirport().getId() == null) {

            throw new RuntimeException(
                "Source airport is required"
            );
        }

        if (flight.getDestinationAirport() == null ||
            flight.getDestinationAirport().getId() == null) {

            throw new RuntimeException(
                "Destination airport is required"
            );
        }

        Long sourceId =
                flight.getSourceAirport().getId();

        Long destinationId =
                flight.getDestinationAirport().getId();

        if (sourceId.equals(destinationId)) {
            throw new RuntimeException(
                "Source and destination cannot be same"
            );
        }

        Airport sourceAirport =
                airportRepository
                    .findById(sourceId)
                    .orElseThrow(() ->
                        new RuntimeException(
                            "Source airport not found: "
                            + sourceId
                        )
                    );

        Airport destinationAirport =
                airportRepository
                    .findById(destinationId)
                    .orElseThrow(() ->
                        new RuntimeException(
                            "Destination airport not found: "
                            + destinationId
                        )
                    );

        flight.setSourceAirport(sourceAirport);
        flight.setDestinationAirport(destinationAirport);

        if (flight.getStatus() == null ||
            flight.getStatus().trim().isEmpty()) {

            flight.setStatus("ACTIVE");
        }

        if (flight.getTotalSeats() == null ||
            flight.getTotalSeats() <= 0) {

            flight.setTotalSeats(52);
        }

        if (flight.getAvailableSeats() == null ||
            flight.getAvailableSeats() < 0) {

            flight.setAvailableSeats(
                flight.getTotalSeats()
            );
        }

        return flightRepository.save(flight);
    }

    // =====================================================
    // GET ALL FLIGHTS
    // =====================================================

    @Override
    public List<Flight> getAllFlights() {

        return flightRepository.findAll();
    }

    // =====================================================
    // GET FLIGHT BY ID
    // =====================================================

    @Override
    public Flight getFlightById(Long id) {

        return flightRepository
                .findById(id)
                .orElse(null);
    }

    // =====================================================
    // UPDATE FLIGHT
    // =====================================================

    @Override
    public Flight updateFlight(
            Long id,
            Flight flight) {

        Flight existingFlight =
                flightRepository
                    .findById(id)
                    .orElse(null);

        if (existingFlight == null) {
            return null;
        }

        existingFlight.setFlightNumber(
            flight.getFlightNumber()
        );

        existingFlight.setAirlineName(
            flight.getAirlineName()
        );

        existingFlight.setPrice(
            flight.getPrice()
        );

        existingFlight.setStatus(
            flight.getStatus()
        );

        existingFlight.setAvailableSeats(
            flight.getAvailableSeats()
        );

        existingFlight.setTotalSeats(
            flight.getTotalSeats()
        );

        if (flight.getSourceAirport() != null &&
            flight.getSourceAirport().getId() != null) {

            Airport sourceAirport =
                    airportRepository
                        .findById(
                            flight.getSourceAirport().getId()
                        )
                        .orElseThrow(() ->
                            new RuntimeException(
                                "Source airport not found"
                            )
                        );

            existingFlight.setSourceAirport(
                sourceAirport
            );
        }

        if (flight.getDestinationAirport() != null &&
            flight.getDestinationAirport().getId() != null) {

            Airport destinationAirport =
                    airportRepository
                        .findById(
                            flight.getDestinationAirport().getId()
                        )
                        .orElseThrow(() ->
                            new RuntimeException(
                                "Destination airport not found"
                            )
                        );

            existingFlight.setDestinationAirport(
                destinationAirport
            );
        }

        return flightRepository.save(existingFlight);
    }

    // =====================================================
    // DELETE FLIGHT
    // =====================================================

    @Override
    public void deleteFlight(Long id) {

        if (!flightRepository.existsById(id)) {

            throw new RuntimeException(
                "Flight not found with ID: " + id
            );
        }

        if (bookingRepository.existsByFlightId(id)) {

            throw new RuntimeException(
                "Flight cannot be deleted because bookings exist"
            );
        }

        flightRepository.deleteById(id);
    }

    // =====================================================
    // SEARCH BY CITY
    // =====================================================

    @Override
    public List<Flight> searchFlight(
            String source,
            String destination) {

        Airport sourceAirport =
                airportRepository
                    .findByCityIgnoreCase(
                        source.trim()
                    );

        Airport destinationAirport =
                airportRepository
                    .findByCityIgnoreCase(
                        destination.trim()
                    );

        if (sourceAirport == null ||
            destinationAirport == null) {

            return List.of();
        }

        return flightRepository
                .findBySourceAirportAndDestinationAirport(
                    sourceAirport,
                    destinationAirport
                );
    }

    // =====================================================
    // SEARCH BY AIRPORT CODE
    // =====================================================

    @Override
    public List<Flight> searchFlights(
            String source,
            String destination) {

        return flightRepository
            .findBySourceAirportAirportCodeAndDestinationAirportAirportCode(
                source.trim().toUpperCase(),
                destination.trim().toUpperCase()
            );
    }

    // =====================================================
    // CANCEL FLIGHT
    // =====================================================

    @Override
    public Flight cancelFlight(Long id) {

        Flight flight =
                flightRepository
                    .findById(id)
                    .orElseThrow(() ->
                        new RuntimeException(
                            "Flight not found with ID: " + id
                        )
                    );

        if ("CANCELLED".equalsIgnoreCase(
                flight.getStatus())) {

            throw new RuntimeException(
                "Flight is already cancelled"
            );
        }

        flight.setStatus("CANCELLED");

        return flightRepository.save(flight);
    }
}