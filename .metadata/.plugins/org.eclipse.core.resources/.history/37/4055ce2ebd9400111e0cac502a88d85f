import { useLocation, useNavigate } from "react-router-dom";
import { useState } from "react";

function SeatSelection() {
  const location = useLocation();
  const navigate = useNavigate();

  const {
    flight,
    from,
    to,
    travelDate,
    passengers,
    userId,
    passengerId,
    passengerName,
  } = location.state || {};

  const [selectedSeats, setSelectedSeats] = useState([]);

  const seats = [
    "1A", "1B", "1C", "1D",
    "2A", "2B", "2C", "2D",
    "3A", "3B", "3C", "3D",
    "4A", "4B", "4C", "4D",
    "5A", "5B", "5C", "5D",
    "6A", "6B", "6C", "6D",
    "7A", "7B", "7C", "7D",
  ];

  // Seat select / deselect
  const handleSeatClick = (seat) => {
    if (selectedSeats.includes(seat)) {
      setSelectedSeats(
        selectedSeats.filter((item) => item !== seat)
      );
      return;
    }

    if (selectedSeats.length >= passengers) {
      alert(
        `You can select only ${passengers} seat(s).`
      );
      return;
    }

    setSelectedSeats([
      ...selectedSeats,
      seat,
    ]);
  };

  // Continue to Payment
  const handleContinue = () => {
    if (selectedSeats.length !== passengers) {
      alert(
        `Please select ${passengers} seat(s).`
      );
      return;
    }

    if (!flight || !flight.id) {
      alert("Flight information is missing.");
      console.error("Flight:", flight);
      return;
    }

    if (!userId) {
      alert("User ID missing. Please login again.");
      return;
    }

    if (!passengerId) {
      alert(
        "Passenger ID missing. Please start booking again."
      );
      return;
    }

    console.log("========== BOOKING DATA ==========");
    console.log("User ID:", userId);
    console.log("Flight ID:", flight.id);
    console.log("Passenger ID:", passengerId);
    console.log("Selected Seats:", selectedSeats);
    console.log("==================================");

    navigate("/payment", {
      state: {
        flight: flight,
        from: from,
        to: to,
        travelDate: travelDate,
        passengers: passengers,

        userId: userId,
        passengerId: passengerId,
        passengerName: passengerName,

        selectedSeats: selectedSeats,
      },
    });
  };

  // If data missing
  if (!flight || !userId || !passengerId) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif",
        }}
      >
        <div
          style={{
            background: "white",
            padding: "40px",
            borderRadius: "12px",
            textAlign: "center",
            boxShadow:
              "0 3px 12px rgba(0,0,0,0.08)",
          }}
        >
          <h2>Booking Information Missing</h2>

          <p>
            Please start the booking process again.
          </p>

          <button
            onClick={() => navigate("/")}
            style={{
              padding: "12px 25px",
              background: "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "6px",
              cursor: "pointer",
            }}
          >
            Back to Home
          </button>
        </div>
      </div>
    );
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f5f7fa",
        padding: "40px",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <div
        style={{
          maxWidth: "1000px",
          margin: "0 auto",
        }}
      >
        <h1>Select Your Seat</h1>

        <p>
          {flight.airlineName || flight.airline}
          {" - "}
          {flight.flightNumber}
        </p>

        <p>
          {from} → {to} | {travelDate}
        </p>

        <hr />

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "1fr 1fr",
            gap: "30px",
            marginTop: "30px",
          }}
        >
          {/* SEAT SECTION */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              boxShadow:
                "0 3px 12px rgba(0,0,0,0.08)",
            }}
          >
            <h2>Aircraft Seats</h2>

            <p>
              Select {passengers} seat(s)
            </p>

            <div
              style={{
                display: "grid",
                gridTemplateColumns:
                  "1fr 1fr 40px 1fr 1fr",
                gap: "12px",
                marginTop: "25px",
              }}
            >
              {seats.map((seat) => {
                const selected =
                  selectedSeats.includes(seat);

                return (
                  <button
                    key={seat}
                    onClick={() =>
                      handleSeatClick(seat)
                    }
                    style={{
                      padding: "12px 5px",
                      border: "none",
                      borderRadius: "6px",
                      cursor: "pointer",
                      background: selected
                        ? "#0066ff"
                        : "#e8f0ff",
                      color: selected
                        ? "white"
                        : "#333",
                      fontWeight: "bold",
                    }}
                  >
                    {seat}
                  </button>
                );
              })}
            </div>

            <div
              style={{
                marginTop: "25px",
                display: "flex",
                gap: "20px",
              }}
            >
              <span>⬜ Available</span>
              <span>🟦 Selected</span>
            </div>
          </div>

          {/* SUMMARY SECTION */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "12px",
              boxShadow:
                "0 3px 12px rgba(0,0,0,0.08)",
            }}
          >
            <h2>Booking Summary</h2>

            <hr />

            <p>
              <strong>Passenger:</strong>{" "}
              {passengerName}
            </p>

            <p>
              <strong>Flight:</strong>{" "}
              {flight.flightNumber}
            </p>

            <p>
              <strong>Flight ID:</strong>{" "}
              {flight.id}
            </p>

            <p>
              <strong>Route:</strong>{" "}
              {from} → {to}
            </p>

            <p>
              <strong>Travel Date:</strong>{" "}
              {travelDate}
            </p>

            <p>
              <strong>Passengers:</strong>{" "}
              {passengers}
            </p>

            <hr />

            <h3>Selected Seats</h3>

            <p>
              {selectedSeats.length > 0
                ? selectedSeats.join(", ")
                : "No seat selected"}
            </p>

            <hr />

            <h2>
              ₹{flight.price * passengers}
            </h2>

            <p>Total Price</p>

            <div
              style={{
                marginTop: "25px",
              }}
            >
              <button
                onClick={() => navigate(-1)}
                style={{
                  padding: "12px 20px",
                  marginRight: "10px",
                  border: "none",
                  borderRadius: "6px",
                  cursor: "pointer",
                }}
              >
                Back
              </button>

              <button
                onClick={handleContinue}
                style={{
                  padding: "12px 25px",
                  background: "#0066ff",
                  color: "white",
                  border: "none",
                  borderRadius: "6px",
                  cursor: "pointer",
                  fontWeight: "bold",
                }}
              >
                Continue to Payment
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default SeatSelection;