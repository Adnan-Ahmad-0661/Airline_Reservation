package com.airline.reservation.service.impl;

import java.time.LocalDateTime;
import java.util.List;
import java.util.stream.Collectors;

import javax.transaction.Transactional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;

import com.airline.reservation.dto.BookingResponse;
import com.airline.reservation.dto.UserResponse;
import com.airline.reservation.entity.Booking;
import com.airline.reservation.entity.Flight;
import com.airline.reservation.entity.Passenger;
import com.airline.reservation.entity.Seat;
import com.airline.reservation.entity.User;
import com.airline.reservation.repository.BookingRepository;
import com.airline.reservation.repository.FlightRepository;
import com.airline.reservation.repository.PassengerRepository;
import com.airline.reservation.repository.SeatRepository;
import com.airline.reservation.repository.UserRepository;
import com.airline.reservation.service.BookingService;

@Service
@Transactional
public class BookingServiceImpl implements BookingService {

	@Autowired
	private BookingRepository bookingRepository;

	@Autowired
	private SeatRepository seatRepository;

	@Autowired
	private UserRepository userRepository;

	@Autowired
	private FlightRepository flightRepository;

	@Autowired
	private PassengerRepository passengerRepository;

	// =====================================================
	// CREATE BOOKING
	// =====================================================

	@Override
	public Booking createBooking(Long userId, Long flightId, Long passengerId, String seatNumber) {

		System.out.println("========== CREATE BOOKING ==========");
		System.out.println("User ID      : " + userId);
		System.out.println("Flight ID    : " + flightId);
		System.out.println("Passenger ID : " + passengerId);
		System.out.println("Seat Number  : " + seatNumber);

		// =====================================================
		// 1. USER CHECK
		// =====================================================

		User user = userRepository.findById(userId)
				.orElseThrow(() -> new RuntimeException("User not found with ID: " + userId));

		// =====================================================
		// 2. FLIGHT CHECK
		// =====================================================

		Flight flight = flightRepository.findById(flightId)
				.orElseThrow(() -> new RuntimeException("Flight not found with ID: " + flightId));

		// =====================================================
		// 3. PASSENGER CHECK
		// =====================================================

		Passenger passenger = passengerRepository.findById(passengerId)
				.orElseThrow(() -> new RuntimeException("Passenger not found with ID: " + passengerId));

		// =====================================================
		// 4. SEAT NUMBER CHECK
		// =====================================================

		if (seatNumber == null || seatNumber.trim().isEmpty()) {

			throw new RuntimeException("Seat number is required");
		}

		seatNumber = seatNumber.trim();

		// =====================================================
		// 5. AVAILABLE SEATS CHECK
		// =====================================================

		if (flight.getAvailableSeats() == null || flight.getAvailableSeats() <= 0) {

			throw new RuntimeException("No seats available on this flight");
		}

		// =====================================================
		// 6. FIND SEAT
		// =====================================================

		Seat seat = seatRepository.findByFlightAndSeatNumber(flight, seatNumber);

		if (seat == null) {

			throw new RuntimeException("Seat " + seatNumber + " not found for Flight ID " + flightId);
		}

		// =====================================================
		// 7. CHECK SEAT STATUS
		// =====================================================

		if ("BOOKED".equalsIgnoreCase(seat.getStatus())) {

			throw new RuntimeException("Seat " + seatNumber + " is already booked");
		}

		// =====================================================
		// 8. BOOK SEAT
		// =====================================================

		seat.setStatus("BOOKED");

		seatRepository.saveAndFlush(seat);

		// =====================================================
		// 9. DECREASE AVAILABLE SEATS
		// =====================================================

		flight.setAvailableSeats(flight.getAvailableSeats() - 1);

		flightRepository.saveAndFlush(flight);

		// =====================================================
		// 10. CREATE BOOKING
		// =====================================================

		Booking booking = new Booking();

		booking.setUser(user);
		booking.setFlight(flight);
		booking.setPassenger(passenger);
		booking.setSeatNumber(seatNumber);
		booking.setBookingDate(LocalDateTime.now());
		booking.setAmount(flight.getPrice());
		booking.setStatus("CONFIRMED");

		// =====================================================
		// 11. GENERATE PNR
		// =====================================================

		booking.setPnr("PNR" + System.currentTimeMillis());

		// =====================================================
		// 12. SAVE BOOKING
		// =====================================================

		Booking savedBooking = bookingRepository.saveAndFlush(booking);

		System.out.println("BOOKING CREATED ID: " + savedBooking.getId());

		System.out.println("PNR: " + savedBooking.getPnr());

		System.out.println("SEAT: " + savedBooking.getSeatNumber());

		System.out.println("===================================");

		// =====================================================
		// 13. RETURN DTO
		// =====================================================

		return savedBooking;
	}

	// =====================================================
	// GET ALL BOOKINGS
	// =====================================================

	@Override
	public List<BookingResponse> getAllBookings() {

		List<Booking> bookings = bookingRepository.findAll();

		return bookings.stream().map(this::convertToBookingResponse).collect(Collectors.toList());
	}

	// =====================================================
	// GET BOOKING BY PNR
	// =====================================================

	@Override
	public BookingResponse getBookingByPnr(String pnr) {

		Booking booking = bookingRepository.findByPnr(pnr);

		if (booking == null) {
			return null;
		}

		return convertToBookingResponse(booking);
	}

	// =====================================================
	// CANCEL BOOKING
	// =====================================================

	@Override
	@Transactional
	public Booking cancelBooking(Long bookingId) {

		System.out.println("========== CANCEL BOOKING ==========");

		System.out.println("Booking ID: " + bookingId);

		// =====================================================
		// 1. FIND BOOKING
		// =====================================================

		Booking booking = bookingRepository.findById(bookingId)
				.orElseThrow(() -> new RuntimeException("Booking not found with ID: " + bookingId));

		// =====================================================
		// 2. GET LOGGED-IN USER
		// =====================================================

		Authentication authentication = SecurityContextHolder.getContext().getAuthentication();

		String email = authentication.getName();

		// =====================================================
		// 3. CHECK ADMIN
		// =====================================================

		boolean isAdmin = authentication.getAuthorities().stream()
				.anyMatch(authority -> authority.getAuthority().equals("ROLE_ADMIN"));

		// =====================================================
		// 4. USER / ADMIN AUTHORIZATION
		// =====================================================

		if (!isAdmin && !booking.getUser().getEmail().equals(email)) {

			throw new RuntimeException("You are not allowed to cancel this booking");
		}

		// =====================================================
		// 5. ALREADY CANCELLED CHECK
		// =====================================================

		if ("CANCELLED".equalsIgnoreCase(booking.getStatus())) {

			throw new RuntimeException("Booking already cancelled");
		}

		// =====================================================
		// 6. GET FLIGHT
		// =====================================================

		Flight flight = booking.getFlight();

		if (flight == null) {

			throw new RuntimeException("Flight not found for booking");
		}

		String seatNumber = booking.getSeatNumber();

		// =====================================================
		// 7. FIND SEAT
		// =====================================================

		Seat seat = seatRepository.findByFlightAndSeatNumber(flight, seatNumber);

		if (seat == null) {

			throw new RuntimeException("Seat " + seatNumber + " not found for Flight ID " + flight.getId());
		}

		// =====================================================
		// 8. CANCEL BOOKING
		// =====================================================

		booking.setStatus("CANCELLED");

		bookingRepository.save(booking);

		// =====================================================
		// 9. RELEASE SEAT
		// =====================================================

		seat.setStatus("AVAILABLE");

		seatRepository.save(seat);

		// =====================================================
		// 10. INCREASE AVAILABLE SEATS
		// =====================================================

		if (flight.getAvailableSeats() != null) {

			flight.setAvailableSeats(flight.getAvailableSeats() + 1);

			flightRepository.save(flight);
		}

		// =====================================================
		// 11. LOG
		// =====================================================

		System.out.println("Seat " + seatNumber + " is now AVAILABLE");

		System.out.println("Available Seats: " + flight.getAvailableSeats());

		System.out.println("Booking cancelled successfully");

		System.out.println("===================================");

		// =====================================================
		// 12. RETURN DTO
		// =====================================================

		return booking;
	}

	// =====================================================
	// GET BOOKING BY ID
	// =====================================================

	@Override
	public BookingResponse getBookingById(Long id) {

	    System.out.println("========== GET BOOKING BY ID ==========");
	    System.out.println("Booking ID: " + id);

	    // 1. FIND BOOKING
	    Booking booking = bookingRepository.findById(id)
	            .orElseThrow(() ->
	                    new RuntimeException(
	                            "Booking not found with ID: " + id));

	    // 2. LOG BOOKING USER
	    if (booking.getUser() != null) {
	        System.out.println(
	                "Booking User ID: " +
	                booking.getUser().getId()
	        );

	        System.out.println(
	                "Booking User Email: " +
	                booking.getUser().getEmail()
	        );
	    }

	    // 3. GET LOGGED-IN USER
	    Authentication authentication =
	            SecurityContextHolder.getContext()
	                    .getAuthentication();

	    if (authentication != null) {

	        System.out.println(
	                "Logged-in Email: " +
	                authentication.getName()
	        );

	        System.out.println(
	                "Authorities: " +
	                authentication.getAuthorities()
	        );
	    }

	    // 4. CONVERT BOOKING TO RESPONSE
	    BookingResponse response =
	            convertToBookingResponse(booking);

	    System.out.println(
	            "Booking found successfully: " +
	            booking.getId()
	    );

	    System.out.println("======================================");

	    return response;
	}
	// =====================================================
	// GET BOOKINGS BY USER
	// =====================================================

	@Override
	public List<BookingResponse> getBookingsByUserId(Long userId) {

		List<Booking> bookings = bookingRepository.findByUserId(userId);

		return bookings.stream().map(this::convertToBookingResponse).collect(Collectors.toList());
	}

	// =====================================================
	// CONVERT BOOKING -> BOOKING RESPONSE
	// =====================================================

	private BookingResponse convertToBookingResponse(Booking booking) {

		BookingResponse response = new BookingResponse();

		// =====================================================
		// BOOKING DETAILS
		// =====================================================

		response.setId(booking.getId());

		response.setPnr(booking.getPnr());

		response.setAmount(booking.getAmount());

		response.setBookingDate(booking.getBookingDate());

		response.setSeatNumber(booking.getSeatNumber());

		response.setStatus(booking.getStatus());

		// =====================================================
		// USER -> USER RESPONSE
		// =====================================================

		User user = booking.getUser();

		if (user != null) {

			UserResponse userResponse = new UserResponse();

			userResponse.setId(user.getId());

			userResponse.setEmail(user.getEmail());

			userResponse.setName(user.getName());

			userResponse.setPhone(user.getPhone());

			userResponse.setRole(user.getRole());

			// PASSWORD INTENTIONALLY NOT SET

			response.setUser(userResponse);
		}

		// =====================================================
		// FLIGHT
		// =====================================================

		response.setFlight(booking.getFlight());

		// =====================================================
		// PASSENGER
		// =====================================================

		response.setPassenger(booking.getPassenger());

		return response;
	}
}