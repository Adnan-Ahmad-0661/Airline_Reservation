package com.airline.reservation.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.airline.reservation.entity.Airport;
import com.airline.reservation.entity.Flight;
import com.airline.reservation.repository.AirportRepository;
import com.airline.reservation.repository.BookingRepository;
import com.airline.reservation.repository.FlightRepository;
import com.airline.reservation.service.FlightService;

@Service
public class FlightServiceImpl implements FlightService {

	@Autowired
	private FlightRepository flightRepository;

	@Autowired
	private BookingRepository bookingRepository;

	@Autowired
	private AirportRepository airportRepository;

	@Override
	public Flight addFlight(Flight flight) {

		Long sourceId = flight.getSourceAirport().getId();
		Long destinationId = flight.getDestinationAirport().getId();

		Airport sourceAirport = airportRepository.findById(sourceId).orElse(null);

		Airport destinationAirport = airportRepository.findById(destinationId).orElse(null);

		if (sourceAirport == null) {
			throw new RuntimeException("Source airport not found: " + sourceId);
		}

		if (destinationAirport == null) {
			throw new RuntimeException("Destination airport not found: " + destinationId);
		}

		flight.setSourceAirport(sourceAirport);
		flight.setDestinationAirport(destinationAirport);

		return flightRepository.save(flight);
	}

	@Override
	public Flight getFlightById(Long id) {
		return flightRepository.findById(id).orElse(null);
	}

	@Override
	public List<Flight> getAllFlights() {
		return flightRepository.findAll();

	}

	@Override
	public Flight updateFlight(Long id, Flight flight) {

	    Flight existingFlight = flightRepository.findById(id).orElse(null);

	    if (existingFlight == null) {
	        return null;
	    }

	    existingFlight.setFlightNumber(flight.getFlightNumber());
	    existingFlight.setAirlineName(flight.getAirlineName());
	    existingFlight.setPrice(flight.getPrice());
	    existingFlight.setStatus(flight.getStatus());
	    existingFlight.setAvailableSeats(flight.getAvailableSeats());
	    existingFlight.setTotalSeats(flight.getTotalSeats());

	    // Source Airport: only ID required
	    if (flight.getSourceAirport() != null
	            && flight.getSourceAirport().getId() != null) {

	        Airport sourceAirport = airportRepository
	                .findById(flight.getSourceAirport().getId())
	                .orElseThrow(() ->
	                        new RuntimeException("Source Airport not found"));

	        existingFlight.setSourceAirport(sourceAirport);
	    }

	    // Destination Airport: only ID required
	    if (flight.getDestinationAirport() != null
	            && flight.getDestinationAirport().getId() != null) {

	        Airport destinationAirport = airportRepository
	                .findById(flight.getDestinationAirport().getId())
	                .orElseThrow(() ->
	                        new RuntimeException("Destination Airport not found"));

	        existingFlight.setDestinationAirport(destinationAirport);
	    }

	    return flightRepository.save(existingFlight);
	}
	@Override
	public void deleteFlight(Long id) {

		if (!flightRepository.existsById(id)) {
			throw new RuntimeException("Flight not found with ID: " + id);
		}

		if (bookingRepository.existsByFlightId(id)) {
			throw new RuntimeException("Flight cannot be deleted because bookings exist");
		}

		flightRepository.deleteById(id);
	}

	@Override
	public List<Flight> searchFlight(String source, String destination) {

		Airport sourceAirport = airportRepository.findByCityIgnoreCase(source.trim());

		Airport destinationAirport = airportRepository.findByCityIgnoreCase(destination.trim());

		if (sourceAirport == null || destinationAirport == null) {
			return null;
		}

		return flightRepository.findBySourceAirportAndDestinationAirport(sourceAirport, destinationAirport);
	}

	@Override
	public List<Flight> searchFlights(String source, String destination) {

		return flightRepository.findBySourceAirportAirportCodeAndDestinationAirportAirportCode(source, destination);
	}

	@Override
	public Flight cancelFlight(Long id) {
		// TODO Auto-generated method stub
		Flight flight = flightRepository.findById(id)
				.orElseThrow(() -> new RuntimeException("Flight not found with ID: " + id));
		if ("CANCELLED".equalsIgnoreCase(flight.getStatus())) {
			throw new RuntimeException("Flight is already cancelled");
		}

		flight.setStatus("CANCELLED");

		return flightRepository.save(flight);
	}
}
