
/* eslint-disable react-hooks/set-state-in-effect */

import { useLocation, useNavigate } from "react-router-dom";
import { useEffect, useState } from "react";

function SeatSelection() {

  const location = useLocation();
  const navigate = useNavigate();

  // =====================================================
  // BOOKING DATA
  // =====================================================

  const bookingData = location.state || {};

  const flight = bookingData.flight;

  const flightId = Number(
    bookingData.flightId ||
    flight?.id ||
    0
  );

  const from =
    bookingData.from ||
    flight?.source ||
    flight?.sourceAirport?.airportName ||
    flight?.sourceAirport?.airportCode ||
    "";

  const to =
    bookingData.to ||
    flight?.destination ||
    flight?.destinationAirport?.airportName ||
    flight?.destinationAirport?.airportCode ||
    "";

  const travelDate =
    bookingData.travelDate || "";

  const passengers =
    Number(bookingData.passengers) || 1;

  const passengerId =
    Number(bookingData.passengerId) || 0;

  const passengerName =
    bookingData.passengerName || "";

  const passengerAge =
    bookingData.passengerAge || "";

  const passengerGender =
    bookingData.passengerGender || "";

  const passportNumber =
    bookingData.passportNumber || "";

  // =====================================================
  // STATE
  // =====================================================

  const [selectedSeats, setSelectedSeats] = useState([]);

  const [bookedSeats, setBookedSeats] = useState([]);

  const [loadingSeats, setLoadingSeats] = useState(true);

  // =====================================================
  // 52 SEATS
  // =====================================================

  const seats = [
    "1A", "1B", "1C", "1D",
    "2A", "2B", "2C", "2D",
    "3A", "3B", "3C", "3D",
    "4A", "4B", "4C", "4D",
    "5A", "5B", "5C", "5D",
    "6A", "6B", "6C", "6D",
    "7A", "7B", "7C", "7D",
    "8A", "8B", "8C", "8D",
    "9A", "9B", "9C", "9D",
    "10A", "10B", "10C", "10D",
    "11A", "11B", "11C", "11D",
    "12A", "12B", "12C", "12D",
    "13A", "13B", "13C", "13D"
  ];

  // =====================================================
  // PRICE
  // =====================================================

  const pricePerSeat = Number(
    flight?.price ||
    flight?.economyPrice ||
    0
  );

  const totalPrice =
    selectedSeats.length > 0
      ? pricePerSeat * selectedSeats.length
      : 0;

  // =====================================================
  // GET SEATS FROM DATABASE
  // =====================================================

  useEffect(() => {

    if (!flightId) {
      setLoadingSeats(false);
      return;
    }

    const fetchSeats = async () => {

      try {

        setLoadingSeats(true);

        const token =
          localStorage.getItem("token");

        console.log(
          "Fetching seats for Flight ID:",
          flightId
        );

        const response = await fetch(
          `http://localhost:8080/api/seats/flight/${flightId}`,
          {
            method: "GET",
            headers: {
              "Authorization": `Bearer ${token}`,
              "Content-Type": "application/json"
            }
          }
        );

        if (!response.ok) {

          throw new Error(
            `Seat API failed: ${response.status}`
          );
        }

        const data = await response.json();

        console.log(
          "Seats received from DB:",
          data
        );

        // =================================================
        // ONLY BOOKED SEATS
        // =================================================

        const booked = data
          .filter(
            seat =>
              seat.status &&
              seat.status.toUpperCase() === "BOOKED"
          )
          .map(
            seat => seat.seatNumber
          );

        console.log(
          "BOOKED SEATS:",
          booked
        );

        setBookedSeats(booked);

      } catch (error) {

        console.error(
          "Error fetching seats:",
          error
        );

        alert(
          "Unable to load seat information."
        );

      } finally {

        setLoadingSeats(false);
      }
    };

    fetchSeats();

  }, [flightId]);

  // =====================================================
  // AVAILABLE SEATS COUNT
  // =====================================================

  const availableSeats =
    seats.length - bookedSeats.length;

  // =====================================================
  // SEAT CLICK
  // =====================================================

  const handleSeatClick = (seat) => {

    // ===================================================
    // BOOKED SEAT
    // ===================================================

    if (bookedSeats.includes(seat)) {

      alert(
        `Seat ${seat} is already booked.`
      );

      return;
    }

    // ===================================================
    // DESELECT
    // ===================================================

    if (selectedSeats.includes(seat)) {

      setSelectedSeats(
        selectedSeats.filter(
          item => item !== seat
        )
      );

      return;
    }

    // ===================================================
    // MAX SEAT CHECK
    // ===================================================

    if (
      selectedSeats.length >= passengers
    ) {

      alert(
        `You can select maximum ${passengers} seat(s).`
      );

      return;
    }

    // ===================================================
    // SELECT
    // ===================================================

    setSelectedSeats([
      ...selectedSeats,
      seat
    ]);
  };

  // =====================================================
  // CONTINUE
  // =====================================================

  const handleContinue = () => {

    // ===================================================
    // FLIGHT CHECK
    // ===================================================

    if (!flight || !flightId) {

      alert(
        "Flight information is missing. Please select the flight again."
      );

      navigate("/");

      return;
    }

    // ===================================================
    // PASSENGER CHECK
    // ===================================================

    if (!passengerId) {

      alert(
        "Passenger information is missing. Please enter passenger details again."
      );

      navigate("/booking", {
        state: {
          flight,
          flightId,
          from,
          to,
          travelDate,
          passengers
        }
      });

      return;
    }

    // ===================================================
    // SEAT CHECK
    // ===================================================

    if (
      selectedSeats.length !== passengers
    ) {

      alert(
        `Please select ${passengers} seat(s).`
      );

      return;
    }

    // ===================================================
    // PRICE CHECK
    // ===================================================

    if (pricePerSeat <= 0) {

      alert(
        "Flight price is not available."
      );

      return;
    }

    // ===================================================
    // GO PAYMENT
    // ===================================================

    navigate("/payment", {

      state: {

        flight,

        flightId,

        from,

        to,

        travelDate,

        passengers,

        passengerId,

        passengerName,

        passengerAge,

        passengerGender,

        passportNumber,

        selectedSeats,

        pricePerSeat,

        totalPrice

      }

    });
  };

  // =====================================================
  // MISSING INFORMATION
  // =====================================================

  if (
    !flight ||
    !flightId ||
    !passengerId
  ) {

    return (

      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif"
        }}
      >

        <div
          style={{
            background: "white",
            padding: "40px",
            borderRadius: "15px",
            textAlign: "center",
            boxShadow:
              "0 5px 20px rgba(0,0,0,0.10)"
          }}
        >

          <h2>
            Booking Information Missing
          </h2>

          <p>
            Please start the booking process again.
          </p>

          <button
            type="button"
            onClick={() => navigate("/")}
            style={{
              marginTop: "20px",
              padding: "12px 25px",
              background: "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "8px",
              cursor: "pointer",
              fontWeight: "bold"
            }}
          >
            Back to Home
          </button>

        </div>

      </div>
    );
  }

  // =====================================================
  // UI
  // =====================================================

  return (

    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef4ff, #f8fafc)",
        padding: "40px 20px",
        fontFamily: "Arial, sans-serif"
      }}
    >

      <div
        style={{
          maxWidth: "1100px",
          margin: "0 auto"
        }}
      >

        {/* =================================================
            HEADER
        ================================================= */}

        <div
          style={{
            marginBottom: "25px"
          }}
        >

          <h1>
            Select Your Seats
          </h1>

          <p style={{ color: "#666" }}>
            Select{" "}
            <strong>
              {passengers}
            </strong>{" "}
            seat
            {passengers > 1 ? "s" : ""}.
          </p>

        </div>

        {/* =================================================
            FLIGHT INFORMATION
        ================================================= */}

        <div
          style={{
            background: "white",
            padding: "20px",
            borderRadius: "12px",
            boxShadow:
              "0 4px 15px rgba(0,0,0,0.07)",
            marginBottom: "25px"
          }}
        >

          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "repeat(4, 1fr)",
              gap: "20px"
            }}
          >

            <div>

              <small style={{ color: "#777" }}>
                Airline
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.airlineName ||
                  flight.airline ||
                  "Airline"}
              </strong>

            </div>

            <div>

              <small style={{ color: "#777" }}>
                Flight
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {flight.flightNumber || "--"}
              </strong>

            </div>

            <div>

              <small style={{ color: "#777" }}>
                Route
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {from} → {to}
              </strong>

            </div>

            <div>

              <small style={{ color: "#777" }}>
                Travel Date
              </small>

              <strong
                style={{
                  display: "block",
                  marginTop: "5px"
                }}
              >
                {travelDate || "--"}
              </strong>

            </div>

          </div>

        </div>

        {/* =================================================
            MAIN
        ================================================= */}

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "1.3fr 0.7fr",
            gap: "25px"
          }}
        >

          {/* =================================================
              SEAT AREA
          ================================================= */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)"
            }}
          >

            <h2>
              ✈ Aircraft Seats
            </h2>

            {/* =================================================
                SEAT COUNTER
            ================================================= */}

            <div
              style={{
                display: "flex",
                gap: "25px",
                marginTop: "15px",
                marginBottom: "25px"
              }}
            >

              <span>
                Available:{" "}
                <strong>
                  {availableSeats}
                </strong>
              </span>

              <span>
                Booked:{" "}
                <strong>
                  {bookedSeats.length}
                </strong>
              </span>

              <span>
                Selected:{" "}
                <strong>
                  {selectedSeats.length}
                </strong>
              </span>

            </div>

            {/* =================================================
                LOADING
            ================================================= */}

            {loadingSeats ? (

              <div
                style={{
                  textAlign: "center",
                  padding: "50px"
                }}
              >

                <h3>
                  Loading seats...
                </h3>

              </div>

            ) : (

              <div
                style={{
                  maxWidth: "500px",
                  margin: "0 auto"
                }}
              >

                {/* =================================================
                    COCKPIT
                ================================================= */}

                <div
                  style={{
                    textAlign: "center",
                    background: "#e5e7eb",
                    padding: "12px",
                    borderRadius:
                      "50% 50% 10px 10px",
                    marginBottom: "20px",
                    fontWeight: "bold"
                  }}
                >
                  ✈ COCKPIT
                </div>

                {/* =================================================
                    SEATS
                ================================================= */}

                <div
                  style={{
                    display: "grid",
                    gridTemplateColumns:
                      "1fr 1fr 40px 1fr 1fr",
                    gap: "10px"
                  }}
                >

                  {seats.map(
                    (seat, index) => {

                      const selected =
                        selectedSeats.includes(
                          seat
                        );

                      const booked =
                        bookedSeats.includes(
                          seat
                        );

                      const position =
                        index % 4;

                      let gridColumn;

                      if (position === 0) {
                        gridColumn = 1;
                      }
                      else if (position === 1) {
                        gridColumn = 2;
                      }
                      else if (position === 2) {
                        gridColumn = 4;
                      }
                      else {
                        gridColumn = 5;
                      }

                      return (

                        <button
                          key={seat}
                          type="button"
                          disabled={booked}
                          onClick={() =>
                            handleSeatClick(
                              seat
                            )
                          }
                          style={{

                            gridColumn,

                            padding:
                              "12px 5px",

                            border:
                              selected
                                ? "2px solid #0047b3"
                                : booked
                                ? "1px solid #999"
                                : "1px solid #cbd5e1",

                            borderRadius:
                              "7px",

                            cursor:
                              booked
                                ? "not-allowed"
                                : "pointer",

                            background:
                              booked
                                ? "#d1d5db"
                                : selected
                                ? "#0066ff"
                                : "#e8f0ff",

                            color:
                              booked
                                ? "#666"
                                : selected
                                ? "white"
                                : "#333",

                            fontWeight:
                              "bold",

                            opacity:
                              booked
                                ? 0.7
                                : 1

                          }}
                        >

                          {seat}

                        </button>

                      );

                    }
                  )}

                </div>

              </div>

            )}

            {/* =================================================
                LEGEND
            ================================================= */}

            <div
              style={{
                marginTop: "30px",
                display: "flex",
                justifyContent: "center",
                gap: "25px",
                flexWrap: "wrap"
              }}
            >

              <span>
                ⬜ Available
              </span>

              <span>
                🟦 Selected
              </span>

              <span>
                ⬛ Booked
              </span>

            </div>

          </div>

          {/* =================================================
              BOOKING SUMMARY
          ================================================= */}

          <div
            style={{
              background: "white",
              padding: "30px",
              borderRadius: "15px",
              boxShadow:
                "0 5px 20px rgba(0,0,0,0.08)",
              height: "fit-content"
            }}
          >

            <h2>
              Booking Summary
            </h2>

            <hr />

            <p>
              <strong>
                Passenger:
              </strong>
              <br />
              {passengerName || "--"}
            </p>

            <p>
              <strong>
                Passenger ID:
              </strong>
              <br />
              {passengerId}
            </p>

            <p>
              <strong>
                Flight:
              </strong>
              <br />
              {flight.flightNumber || "--"}
            </p>

            <p>
              <strong>
                Route:
              </strong>
              <br />
              {from} → {to}
            </p>

            <p>
              <strong>
                Date:
              </strong>
              <br />
              {travelDate || "--"}
            </p>

            <hr />

            {/* =================================================
                SELECTED SEATS
            ================================================= */}

            <h3>
              Selected Seats
            </h3>

            {selectedSeats.length > 0 ? (

              <div
                style={{
                  display: "flex",
                  flexWrap: "wrap",
                  gap: "8px"
                }}
              >

                {selectedSeats.map(
                  seat => (

                    <span
                      key={seat}
                      style={{
                        background:
                          "#0066ff",
                        color: "white",
                        padding:
                          "8px 12px",
                        borderRadius:
                          "6px",
                        fontWeight:
                          "bold"
                      }}
                    >
                      {seat}
                    </span>

                  )
                )}

              </div>

            ) : (

              <p style={{ color: "#777" }}>
                No seat selected
              </p>

            )}

            <hr />

            {/* =================================================
                TOTAL FARE
            ================================================= */}

            <div
              style={{
                background: "#f0f7ff",
                padding: "15px",
                borderRadius: "10px",
                marginTop: "20px"
              }}
            >

              <p
                style={{
                  margin: 0,
                  color: "#666"
                }}
              >
                Total Fare
              </p>

              <h2
                style={{
                  margin: "5px 0 0",
                  color: "#0066ff"
                }}
              >
                {selectedSeats.length > 0
                  ? `₹${totalPrice}`
                  : "Select seat(s)"}
              </h2>

              {/* =================================================
                  PRICE BREAKDOWN
              ================================================= */}

              {selectedSeats.length > 0 && (

                <p
                  style={{
                    marginTop: "6px",
                    marginBottom: 0,
                    color: "#666",
                    fontSize: "14px"
                  }}
                >
                  ₹{pricePerSeat} ×{" "}
                  {selectedSeats.length} seat
                  {selectedSeats.length > 1
                    ? "s"
                    : ""}
                </p>

              )}

            </div>

            {/* =================================================
                BUTTONS
            ================================================= */}

            <div
              style={{
                display: "flex",
                gap: "10px",
                marginTop: "25px"
              }}
            >

              {/* BACK */}

              <button
                type="button"
                onClick={() =>
                  navigate(-1)
                }
                style={{
                  flex: 1,
                  padding: "13px",
                  background: "#e5e7eb",
                  border: "none",
                  borderRadius: "8px",
                  cursor: "pointer",
                  fontWeight: "bold"
                }}
              >
                ← Back
              </button>

              {/* PAYMENT */}

              <button
                type="button"
                onClick={handleContinue}
                disabled={
                  selectedSeats.length !==
                  passengers
                }
                style={{
                  flex: 2,
                  padding: "13px",
                  background:
                    selectedSeats.length ===
                    passengers
                      ? "#0066ff"
                      : "#9ca3af",
                  color: "white",
                  border: "none",
                  borderRadius: "8px",
                  cursor:
                    selectedSeats.length ===
                    passengers
                      ? "pointer"
                      : "not-allowed",
                  fontWeight: "bold"
                }}
              >
                Continue to Payment →
              </button>

            </div>

          </div>

        </div>

      </div>

    </div>
  );
}

export default SeatSelection;
