import { useState } from "react";
import { useNavigate } from "react-router-dom";

const API_URL = "http://localhost:8080";

function CreateUser() {
  const navigate = useNavigate();

  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const [loading, setLoading] = useState(false);

  const handleCreateUser = async (e) => {
    e.preventDefault();

    if (!name.trim()) {
      alert("Please enter your name");
      return;
    }

    if (!email.trim()) {
      alert("Please enter your email");
      return;
    }

    if (!password.trim()) {
      alert("Please enter your password");
      return;
    }

    if (password.length < 6) {
      alert("Password must be at least 6 characters");
      return;
    }

    try {
      setLoading(true);

      const response = await fetch(
        `${API_URL}/api/users`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            name: name.trim(),
            email: email.trim(),
            password: password,
            role: "USER",
          }),
        }
      );

      const responseText = await response.text();

      console.log(
        "CREATE USER STATUS:",
        response.status
      );

      console.log(
        "CREATE USER RESPONSE:",
        responseText
      );

      if (!response.ok) {
        throw new Error(
          responseText ||
          "Unable to create user"
        );
      }

      alert(
        "User created successfully! Please login."
      );

      // Login page par bhej do
      navigate("/login");

    } catch (error) {

      console.error(
        "CREATE USER ERROR:",
        error
      );

      alert(
        error.message ||
        "User creation failed"
      );

    } finally {

      setLoading(false);

    }
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef4ff, #f8fafc)",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        padding: "20px",
        fontFamily: "Arial, sans-serif",
      }}
    >

      <div
        style={{
          width: "430px",
          maxWidth: "100%",
          background: "white",
          padding: "35px",
          borderRadius: "15px",
          boxShadow:
            "0 5px 20px rgba(0,0,0,0.10)",
        }}
      >

        <h1
          style={{
            textAlign: "center",
            marginBottom: "10px",
          }}
        >
          Create User
        </h1>

        <p
          style={{
            textAlign: "center",
            color: "#666",
            marginBottom: "30px",
          }}
        >
          Create your airline reservation account
        </p>

        <form onSubmit={handleCreateUser}>

          {/* NAME */}

          <div
            style={{
              marginBottom: "20px",
            }}
          >

            <label>
              <strong>
                Full Name
              </strong>
            </label>

            <input
              type="text"
              placeholder="Enter your full name"
              value={name}
              onChange={(e) =>
                setName(e.target.value)
              }
              style={{
                width: "100%",
                padding: "13px",
                marginTop: "8px",
                boxSizing: "border-box",
                border:
                  "1px solid #d1d5db",
                borderRadius: "8px",
                fontSize: "15px",
              }}
            />

          </div>


          {/* EMAIL */}

          <div
            style={{
              marginBottom: "20px",
            }}
          >

            <label>
              <strong>
                Email
              </strong>
            </label>

            <input
              type="email"
              placeholder="Enter your email"
              value={email}
              onChange={(e) =>
                setEmail(e.target.value)
              }
              style={{
                width: "100%",
                padding: "13px",
                marginTop: "8px",
                boxSizing: "border-box",
                border:
                  "1px solid #d1d5db",
                borderRadius: "8px",
                fontSize: "15px",
              }}
            />

          </div>


          {/* PASSWORD */}

          <div
            style={{
              marginBottom: "25px",
            }}
          >

            <label>
              <strong>
                Password
              </strong>
            </label>

            <input
              type="password"
              placeholder="Create password"
              value={password}
              onChange={(e) =>
                setPassword(e.target.value)
              }
              style={{
                width: "100%",
                padding: "13px",
                marginTop: "8px",
                boxSizing: "border-box",
                border:
                  "1px solid #d1d5db",
                borderRadius: "8px",
                fontSize: "15px",
              }}
            />

            <small
              style={{
                color: "#777",
                display: "block",
                marginTop: "6px",
              }}
            >
              Password must be at least 6 characters.
            </small>

          </div>


          {/* CREATE BUTTON */}

          <button
            type="submit"
            disabled={loading}
            style={{
              width: "100%",
              padding: "14px",
              background:
                loading
                  ? "#9ca3af"
                  : "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "8px",
              cursor:
                loading
                  ? "not-allowed"
                  : "pointer",
              fontWeight: "bold",
              fontSize: "16px",
            }}
          >

            {loading
              ? "Creating User..."
              : "Create User"}

          </button>

        </form>


        {/* LOGIN BUTTON */}

        <button
          type="button"
          onClick={() =>
            navigate("/login")
          }
          disabled={loading}
          style={{
            width: "100%",
            padding: "12px",
            marginTop: "12px",
            background: "#e5e7eb",
            color: "#333",
            border: "none",
            borderRadius: "8px",
            cursor:
              loading
                ? "not-allowed"
                : "pointer",
            fontWeight: "bold",
          }}
        >
          Already have an account? Login
        </button>


        {/* HOME BUTTON */}

        <button
          type="button"
          onClick={() =>
            navigate("/")
          }
          disabled={loading}
          style={{
            width: "100%",
            padding: "12px",
            marginTop: "10px",
            background: "white",
            color: "#0066ff",
            border:
              "1px solid #0066ff",
            borderRadius: "8px",
            cursor:
              loading
                ? "not-allowed"
                : "pointer",
          }}
        >
          ← Back to Home
        </button>

      </div>

    </div>
  );
}

export default CreateUser;