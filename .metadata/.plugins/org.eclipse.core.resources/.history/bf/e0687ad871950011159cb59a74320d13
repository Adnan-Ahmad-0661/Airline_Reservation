import { useLocation, useNavigate } from "react-router-dom";

function ViewTicket() {
  const location = useLocation();
  const navigate = useNavigate();

  const booking = location.state?.booking;

  if (!booking) {
    return (
      <div
        style={{
          minHeight: "100vh",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          background: "#f5f7fa",
          fontFamily: "Arial, sans-serif",
        }}
      >
        <div
          style={{
            background: "white",
            padding: "40px",
            borderRadius: "12px",
            textAlign: "center",
            boxShadow: "0 3px 15px rgba(0,0,0,0.1)",
          }}
        >
          <h2>Ticket Not Found</h2>

          <p>
            Booking information is missing.
          </p>

          <button
            onClick={() => navigate("/my-bookings")}
            style={{
              padding: "12px 25px",
              background: "#0066ff",
              color: "white",
              border: "none",
              borderRadius: "6px",
              cursor: "pointer",
              fontWeight: "bold",
            }}
          >
            Back to My Bookings
          </button>
        </div>
      </div>
    );
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#f5f7fa",
        padding: "40px",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <div
        style={{
          maxWidth: "850px",
          margin: "auto",
        }}
      >
        <div
          style={{
            background: "white",
            borderRadius: "15px",
            padding: "35px",
            boxShadow: "0 3px 15px rgba(0,0,0,0.1)",
          }}
        >
          <div
            style={{
              textAlign: "center",
              borderBottom: "2px dashed #ccc",
              paddingBottom: "25px",
            }}
          >
            <h1 style={{ color: "#0066ff" }}>
              ✈ Flight Ticket
            </h1>

            <h2 style={{ color: "#16a34a" }}>
              {booking.status}
            </h2>

            <p>
              Booking confirmed successfully
            </p>
          </div>

          <div style={{ marginTop: "30px" }}>
            <h2>Passenger Details</h2>

            <hr />

            <p>
              <strong>Name:</strong>{" "}
              {booking.passenger?.name || "-"}
            </p>

            <p>
              <strong>Passenger ID:</strong>{" "}
              {booking.passenger?.id ||
                booking.passengerId ||
                "-"}
            </p>
          </div>

          <div style={{ marginTop: "30px" }}>
            <h2>Flight Details</h2>

            <hr />

            <p>
              <strong>Airline:</strong>{" "}
              {booking.flight?.airlineName ||
                booking.flight?.airline ||
                "-"}
            </p>

            <p>
              <strong>Flight Number:</strong>{" "}
              {booking.flight?.flightNumber || "-"}
            </p>

            <p>
              <strong>Flight ID:</strong>{" "}
              {booking.flight?.id ||
                booking.flightId ||
                "-"}
            </p>

            <p>
              <strong>From:</strong>{" "}
              {booking.flight?.sourceAirport?.name ||
                booking.flight?.sourceAirport?.airportName ||
                "-"}
            </p>

            <p>
              <strong>To:</strong>{" "}
              {booking.flight?.destinationAirport?.name ||
                booking.flight?.destinationAirport?.airportName ||
                "-"}
            </p>
          </div>

          <div style={{ marginTop: "30px" }}>
            <h2>Booking Details</h2>

            <hr />

            <p>
              <strong>PNR:</strong>{" "}
              {booking.pnr || "-"}
            </p>

            <p>
              <strong>Seat Number:</strong>{" "}
              {booking.seatNumber || "-"}
            </p>

            <p>
              <strong>Booking ID:</strong>{" "}
              {booking.id || "-"}
            </p>

            <p>
              <strong>Amount:</strong>{" "}
              ₹{booking.amount || 0}
            </p>

            <p>
              <strong>Status:</strong>{" "}
              <span
                style={{
                  color:
                    booking.status === "CONFIRMED"
                      ? "#16a34a"
                      : "#dc2626",
                  fontWeight: "bold",
                }}
              >
                {booking.status || "-"}
              </span>
            </p>

            <p>
              <strong>Booking Date:</strong>{" "}
              {booking.bookingDate
                ? new Date(
                    booking.bookingDate
                  ).toLocaleString()
                : "-"}
            </p>
          </div>

          <div
            style={{
              marginTop: "35px",
              display: "flex",
              gap: "15px",
              justifyContent: "center",
            }}
          >
            <button
              onClick={() =>
                navigate("/my-bookings")
              }
              style={{
                padding: "13px 25px",
                background: "#0066ff",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold",
              }}
            >
              My Bookings
            </button>

            <button
              onClick={() => navigate("/")}
              style={{
                padding: "13px 25px",
                background: "#e5e7eb",
                color: "#333",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold",
              }}
            >
              Home
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export default ViewTicket;