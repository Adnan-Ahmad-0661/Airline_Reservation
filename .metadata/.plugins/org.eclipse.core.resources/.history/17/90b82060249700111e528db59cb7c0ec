
import { useState } from "react";
import { useNavigate } from "react-router-dom";
import API from "../services/api";
import "./Home.css";

function Home() {

  const navigate = useNavigate();

  // =====================================================
  // AIRPORT / CITY LIST
  // =====================================================

  const airports = [
    " Delhi",
    "Ayodhya",
    "Gorakhpur",
    "Bangalore",
    "Lucknow",
    "Mumbai",
    "Kolkata",
    "Chennai",
    "Hyderabad",
    "Ahmedabad",
    "Pune",
    "Jaipur",
    "Patna",
    "Varanasi",
    "Goa"
  ];

  // =====================================================
  // SEARCH STATES
  // =====================================================

  const [from, setFrom] = useState("");
  const [to, setTo] = useState("");
  const [date, setDate] = useState("");
  const [passengers, setPassengers] = useState(1);

  const [flights, setFlights] = useState([]);
  const [loading, setLoading] = useState(false);
  const [searched, setSearched] = useState(false);

  // =====================================================
  // GET TODAY DATE - LOCAL DATE
  // =====================================================

  const getTodayDate = () => {

    const today = new Date();

    const year = today.getFullYear();

    const month = String(
      today.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
      today.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
  };

  // =====================================================
  // SEARCH FLIGHTS
  // =====================================================

  const searchFlights = async () => {

    const source = from.trim();
    const destination = to.trim();

    // ---------------------------------------------------
    // SOURCE VALIDATION
    // ---------------------------------------------------

    if (!source) {

      alert(
        "Please select departure city."
      );

      return;
    }

    // ---------------------------------------------------
    // DESTINATION VALIDATION
    // ---------------------------------------------------

    if (!destination) {

      alert(
        "Please select destination city."
      );

      return;
    }

    // ---------------------------------------------------
    // SAME SOURCE & DESTINATION
    // ---------------------------------------------------

    if (
      source.toLowerCase() ===
      destination.toLowerCase()
    ) {

      alert(
        "Source and destination cannot be same."
      );

      return;
    }

    // ---------------------------------------------------
    // PASSENGER VALIDATION
    // ---------------------------------------------------

    if (
      passengers < 1 ||
      passengers > 10
    ) {

      alert(
        "Passengers must be between 1 and 10."
      );

      return;
    }

    // ---------------------------------------------------
    // DATE VALIDATION
    // ---------------------------------------------------

    if (!date) {

      alert(
        "Please select travel date."
      );

      return;
    }

    const today = getTodayDate();

    if (date < today) {

      alert(
        "Past date is not allowed. Please select today or a future date."
      );

      setDate("");

      return;
    }

    // ---------------------------------------------------
    // API CALL
    // ---------------------------------------------------

    try {

      setLoading(true);

      setSearched(true);

      setFlights([]);

      console.log(
        "================================="
      );

      console.log(
        "SEARCHING FLIGHTS"
      );

      console.log(
        "Source:",
        source
      );

      console.log(
        "Destination:",
        destination
      );

      console.log(
        "Date:",
        date
      );

      console.log(
        "Passengers:",
        passengers
      );

      console.log(
        "================================="
      );

      // -------------------------------------------------
      // API PARAMS
      // -------------------------------------------------

      const params = {

        source: source,

        destination: destination,

        date: date

      };

      // -------------------------------------------------
      // SEARCH API
      // -------------------------------------------------

      const response = await API.get(
        "/api/flights/search",
        {
          params: params
        }
      );

      console.log(
        "Flight Search Status:",
        response.status
      );

      console.log(
        "Flight Search Response:",
        response.data
      );

      const result =
        Array.isArray(response.data)
          ? response.data
          : [];

      setFlights(result);

    } catch (error) {

      console.error(
        "Flight Search Error:",
        error
      );

      setFlights([]);

      if (error.response) {

        console.error(
          "Status:",
          error.response.status
        );

        console.error(
          "Backend Response:",
          error.response.data
        );

        alert(
          error.response.data?.message ||
          "Unable to search flights."
        );

      } else {

        alert(
          "Unable to connect to backend."
        );

      }

    } finally {

      setLoading(false);

    }
  };

  // =====================================================
  // BOOK FLIGHT
  // =====================================================

  const bookFlight = (flight) => {

    console.log(
      "================================="
    );

    console.log(
      "BOOK NOW CLICKED"
    );

    console.log(
      "Flight:",
      flight
    );

    console.log(
      "================================="
    );

    // ---------------------------------------------------
    // LOGIN CHECK
    // ---------------------------------------------------

    const token =
      localStorage.getItem("token");

    if (!token) {

      alert(
        "Please login first to continue booking."
      );

      navigate("/login");

      return;
    }

    // ---------------------------------------------------
    // FLIGHT VALIDATION
    // ---------------------------------------------------

    if (!flight) {

      alert(
        "Flight information is missing."
      );

      return;
    }

    // ---------------------------------------------------
    // FLIGHT ID VALIDATION
    // ---------------------------------------------------

    if (!flight.id) {

      console.error(
        "Flight does not contain ID:",
        flight
      );

      alert(
        "Flight ID is missing."
      );

      return;
    }

    // ---------------------------------------------------
    // NORMALIZE FLIGHT DATA
    // ---------------------------------------------------

    const selectedFlight = {

      ...flight,

      id: Number(
        flight.id
      ),

      airlineName:
        flight.airlineName ||
        flight.airline ||
        "Airline",

      flightNumber:
        flight.flightNumber ||
        flight.flightNo ||
        "--",

      source:
        flight.source ||
        from,

      destination:
        flight.destination ||
        to,

      departureTime:
        flight.departureTime ||
        flight.departure ||
        "--",

      arrivalTime:
        flight.arrivalTime ||
        flight.arrival ||
        "--",

      price:
        Number(
          flight.price || 0
        ),

      availableSeats:
        flight.availableSeats ??
        flight.seatsAvailable ??
        0

    };

    console.log(
      "Selected Flight:",
      selectedFlight
    );

    // ---------------------------------------------------
    // GO TO BOOKING PAGE
    // ---------------------------------------------------

    navigate(
      "/booking",
      {
        state: {

          flight: selectedFlight,

          flightId:
            selectedFlight.id,

          from:
            selectedFlight.source,

          to:
            selectedFlight.destination,

          travelDate:
            date,

          passengers:
            Number(passengers)

        }
      }
    );
  };

  // =====================================================
  // UI
  // =====================================================

  return (

    <div className="home">

      {/* =================================================
          NAVBAR
      ================================================= */}

      <nav className="navbar">

        <div className="logo">

          ✈ Airline Reservation

        </div>

        <div className="nav-links">

          {/* HOME */}

          <button
            type="button"
            onClick={() =>
              navigate("/")
            }
            style={navButtonStyle}
          >
            Home
          </button>

          {/* MY BOOKINGS */}

          <button
            type="button"
            onClick={() =>
              navigate("/my-bookings")
            }
            style={navButtonStyle}
          >
            My Bookings
          </button>

          {/* CREATE USER */}

          <button
            type="button"
            onClick={() =>
              navigate("/create-user")
            }
            style={{
              ...navButtonStyle,
              background: "#16a34a",
              color: "white",
              padding: "9px 16px",
              borderRadius: "6px"
            }}
          >
            👤 Create User
          </button>

          {/* LOGIN */}

          <button
            type="button"
            onClick={() =>
              navigate("/login")
            }
            style={navButtonStyle}
          >
            Login
          </button>

        </div>

      </nav>


      {/* =================================================
          HERO
      ================================================= */}

      <section className="hero">

        <div className="hero-content">

          <h1>
            Book Your Flight
          </h1>

          <p>
            Search and book flights easily with
            our Airline Reservation System
          </p>


          {/* =================================================
              SEARCH CARD
          ================================================= */}

          <div
            className="search-card"
            style={{
              alignItems: "flex-start"
            }}
          >

            {/* =================================================
                FROM
            ================================================= */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                From
              </label>

              <select
                value={from}
                onChange={(e) =>
                  setFrom(e.target.value)
                }
                style={selectStyle}
              >

                <option value="">
                  Select departure city
                </option>

                {airports.map(
                  (airport) => (

                    <option
                      key={airport}
                      value={airport}
                    >
                      {airport}
                    </option>

                  )
                )}

              </select>

            </div>


            {/* =================================================
                TO
            ================================================= */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                To
              </label>

              <select
                value={to}
                onChange={(e) =>
                  setTo(e.target.value)
                }
                style={selectStyle}
              >

                <option value="">
                  Select destination city
                </option>

                {airports.map(
                  (airport) => (

                    <option
                      key={airport}
                      value={airport}
                    >
                      {airport}
                    </option>

                  )
                )}

              </select>

            </div>


            {/* =================================================
                DATE
            ================================================= */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                Date
              </label>

              <input
                type="date"
                value={date}
                min={getTodayDate()}
                onChange={(e) => {

                  const selectedDate =
                    e.target.value;

                  const today =
                    getTodayDate();

                  if (
                    selectedDate &&
                    selectedDate < today
                  ) {

                    alert(
                      "Past date cannot be selected."
                    );

                    setDate("");

                    return;
                  }

                  setDate(
                    selectedDate
                  );

                }}
                style={dateInputStyle}
              />

              <small
                style={{
                  marginTop: "5px",
                  color: "#666",
                  fontSize: "12px",
                  lineHeight: "16px"
                }}
              >
                Today or future date only
              </small>

            </div>


            {/* =================================================
                PASSENGERS
            ================================================= */}

            <div
              className="field"
              style={fieldStyle}
            >

              <label style={labelStyle}>
                Passengers
              </label>

              <select
                value={passengers}
                onChange={(e) =>
                  setPassengers(
                    Number(
                      e.target.value
                    )
                  )
                }
                style={selectStyle}
              >

                {Array.from(
                  {
                    length: 10
                  },
                  (_, index) =>
                    index + 1
                ).map(
                  (number) => (

                    <option
                      key={number}
                      value={number}
                    >
                      {number}
                    </option>

                  )
                )}

              </select>

            </div>


            {/* =================================================
                SEARCH BUTTON
            ================================================= */}

            <button
              type="button"
              className="search-btn"
              onClick={searchFlights}
              disabled={loading}
              style={{
                marginTop: "38px"
              }}
            >

              {loading
                ? "Searching..."
                : "Search Flights"}

            </button>

          </div>

        </div>

      </section>


      {/* =================================================
          FEATURES
      ================================================= */}

      {!searched && (

        <section className="features">

          {/* EASY BOOKING */}

          <div className="feature-card">

            <h3>
              ✈ Easy Booking
            </h3>

            <p>
              Search and book your preferred
              flights quickly and easily.
            </p>

          </div>


          {/* SECURE */}

          <div className="feature-card">

            <h3>
              🔒 Secure
            </h3>

            <p>
              Your account and booking information
              is protected with JWT authentication.
            </p>

          </div>


          {/* MY BOOKINGS */}

          <div className="feature-card">

            <h3>
              📋 My Bookings
            </h3>

            <p>
              View and manage your flight
              bookings in one place.
            </p>

          </div>


          {/* CREATE USER */}

          <div className="feature-card">

            <h3>
              👤 Create Account
            </h3>

            <p>
              Create your airline reservation
              account to book flights.
            </p>

            <button
              type="button"
              onClick={() =>
                navigate("/create-user")
              }
              style={{
                marginTop: "10px",
                padding: "10px 18px",
                background: "#16a34a",
                color: "white",
                border: "none",
                borderRadius: "6px",
                cursor: "pointer",
                fontWeight: "bold"
              }}
            >
              Create User
            </button>

          </div>

        </section>

      )}


      {/* =================================================
          FLIGHT RESULTS
      ================================================= */}

      {searched && (

        <section className="flight-results">

          <h2>
            Available Flights
          </h2>

          <p className="route">

            {from || "--"}

            {" → "}

            {to || "--"}

            {date && (
              <>
                {" | "}
                {date}
              </>
            )}

            {" | "}

            {passengers}

            {" Passenger(s)"}

          </p>


          {/* =================================================
              LOADING
          ================================================= */}

          {loading && (

            <div
              style={{
                textAlign: "center",
                padding: "30px"
              }}
            >

              <p>
                Searching flights...
              </p>

            </div>

          )}


          {/* =================================================
              NO FLIGHTS
          ================================================= */}

          {!loading &&
            flights.length === 0 && (

              <div
                style={{
                  textAlign: "center",
                  padding: "30px"
                }}
              >

                <h3>
                  No flights available
                </h3>

                <p>

                  No flights found from{" "}

                  <strong>
                    {from}
                  </strong>

                  {" "}to{" "}

                  <strong>
                    {to}
                  </strong>.

                </p>

              </div>

            )}


          {/* =================================================
              FLIGHT LIST
          ================================================= */}

          {!loading &&
            flights.length > 0 && (

              <div className="flight-list">

                {flights.map(
                  (flight) => {

                    const airlineName =
                      flight.airlineName ||
                      flight.airline ||
                      "Airline";

                    const flightNumber =
                      flight.flightNumber ||
                      flight.flightNo ||
                      "--";

                    const source =
                      flight.source ||
                      from ||
                      "--";

                    const destination =
                      flight.destination ||
                      to ||
                      "--";

                    const departureTime =
                      flight.departureTime ||
                      flight.departure ||
                      "--";

                    const arrivalTime =
                      flight.arrivalTime ||
                      flight.arrival ||
                      "--";

                    const price =
                      Number(
                        flight.price || 0
                      );

                    const availableSeats =
                      flight.availableSeats ??
                      flight.seatsAvailable ??
                      0;

                    return (

                      <div
                        className="flight-card"
                        key={flight.id}
                      >

                        {/* AIRLINE */}

                        <div>

                          <h3>
                            {airlineName}
                          </h3>

                          <p>
                            {flightNumber}
                          </p>

                        </div>


                        {/* SOURCE */}

                        <div>

                          <h3>
                            {departureTime}
                          </h3>

                          <p>
                            {source}
                          </p>

                        </div>


                        {/* ARROW */}

                        <div className="arrow">
                          →
                        </div>


                        {/* DESTINATION */}

                        <div>

                          <h3>
                            {arrivalTime}
                          </h3>

                          <p>
                            {destination}
                          </p>

                        </div>


                        {/* PRICE + BOOK */}

                        <div>

                          <h3>
                            ₹{price}
                          </h3>

                          <p
                            style={{
                              fontSize: "12px",
                              marginBottom: "8px"
                            }}
                          >
                            Seats:{" "}
                            {availableSeats}
                          </p>

                          <button
                            type="button"
                            className="book-btn"
                            onClick={() =>
                              bookFlight(
                                flight
                              )
                            }
                          >
                            Book Now
                          </button>

                        </div>

                      </div>

                    );

                  }
                )}

              </div>

            )}

        </section>

      )}

    </div>

  );
}


// =====================================================
// NAV BUTTON STYLE
// =====================================================

const navButtonStyle = {

  border: "none",

  background: "transparent",

  cursor: "pointer",

  fontSize: "15px",

  fontWeight: "600",

  padding: "8px 12px"

};


// =====================================================
// FIELD STYLE
// =====================================================

const fieldStyle = {

  display: "flex",

  flexDirection: "column",

  justifyContent: "flex-start",

  minWidth: "0"

};


// =====================================================
// LABEL STYLE
// =====================================================

const labelStyle = {

  display: "block",

  marginBottom: "10px"

};


// =====================================================
// SELECT STYLE
// =====================================================

const selectStyle = {

  width: "100%",

  height: "52px",

  padding: "12px",

  border: "1px solid #ccc",

  borderRadius: "6px",

  fontSize: "16px",

  boxSizing: "border-box",

  background: "white",

  cursor: "pointer"

};


// =====================================================
// DATE INPUT STYLE
// =====================================================

const dateInputStyle = {

  width: "100%",

  height: "52px",

  padding: "12px",

  border: "1px solid #ccc",

  borderRadius: "6px",

  fontSize: "16px",

  boxSizing: "border-box",

  cursor: "pointer"

};


export default Home;